{

assetGlobalDef 
	{
		font					"ergoec" 18			// font
		//smallFont				"aurabesh" 18			// font
		bigFont					"anewhope" 20			// font	
		small2Font				"arialnb" 	14
		cursor					"cursor"			// cursor	
		gradientBar				"ui/assets/gradientbar2.tga"	// gradient bar
		itemFocusSound				"sound/interface/menuroam.wav"	// sound for item getting focus (via keyboard or mouse )	

		fadeClamp				1.0				// sets the fadeup alpha
		fadeCycle				1				// how often fade happens in milliseconds
		fadeAmount				0.1				// amount to adjust alpha per cycle
		
		moveRollSound				"sound/player/roll1"
		moveJumpSound				"sound/weapons/force/jump"

		shadowColor				0.1 0.1 0.1 0.25		// shadow color
		focuscolor				0 0 1 1
		precacheSound
		{
			"sound/interface/choose_color.wav" ;
			"sound/interface/choose_head.wav" ;
			"sound/interface/choose_torso.wav" ;
			"sound/interface/choose_saber.wav" ;
			"sound/interface/choose_hilt.wav" ;
			"sound/interface/choose_blade.wav" ;
			"sound/interface/transition.wav"  ;
			"sound/interface/esc.wav" ;
			"sound/interface/sub_select.wav" ;
		}
	}


menuDef {
    	name "UrlRedirectDownload"
      	rect 0 0 640 480
    	fullScreen 0
    	visible 0
      	focusColor				1 1 1 1					// Focus color for text and items
	descX					300
	descY					240
	descScale				0.7
	descColor				1 .682 0 .8
	descAlignment				ITEM_ALIGN_CENTER

	
	itemDef 
		{
			name				button_glow
			group				none
			style				WINDOW_STYLE_SHADER
			rect				0 0 0 0
			background			"gfx/menus/menu_buttonback"
			forecolor			1 1 1 1
			visible				0
			decoration
		}
	
	itemDef 
	{
		name				abordURLRedirectCurrDownload
		group				options
		text				"Abort"
		type				ITEM_TYPE_BUTTON
		style				WINDOW_STYLE_EMPTY
		rect				250 205 60 14 
		textaligny			0
		font 				3
		textscale 			0.6       
		textalign			ITEM_ALIGN_LEFT
		textalignx			0
		descText			"It will abort the current download."
		forecolor			1 .682 0 1
		visible			1
		

		action 
		{
			play			"sound/interface/button1"
			uiscript 		abordURLRedirectCurrDownload 0;
			
		}
		mouseEnter 
		{ 
			show			button_glow 
			setitemrect		button_glow	250 205 70 14
			
		}
		mouseExit 
		{ 
			hide			button_glow 
			 
		}	
		  	  

	}
	
	itemDef 
	{
		name				abordURLRedirectAllDownload
		group				options
		text				"Abort All"
		type				ITEM_TYPE_BUTTON
		style				WINDOW_STYLE_EMPTY
		rect				320 205 75 14 
		textaligny			0
		font 				3
		textscale 			0.6       
		textalign			ITEM_ALIGN_LEFT
		textalignx			0
		descText			"It will abort All the downloading process for the needed Files."
		forecolor			1 .682 0 1
		visible			1
		

		action 
		{
			play			"sound/interface/button1"
			uiscript 		abordURLRedirectCurrDownload 1;
			
		}
		mouseEnter 
		{ 
			show			button_glow 
			setitemrect		button_glow	320 205 85 14
			
		}
		mouseExit 
		{ 
			hide			button_glow 
			 
		}	
		  	  

	}
  }

}