			textaligny				6
			textalign				ITEM_ALIGN_LEFT
			textstyle				0
			textalignx				16
			forecolor				1 1 1 1
			visible					1
			mouseEnter
			{
				show button_glow
				setitemrect button_glow 16 210 210 32
				show playbutton_undertext
			}
			mouseExit
			{
				hide button_glow
				hide playbutton_undertext
			}
			action
			{
				play "sound/interface/button1.wav" ;
				close all ;
				open multiplayermenu
			}
			caps					1
		}

