// setup.menu in the new look. Made by tools/menus/build.py from ui/jamp/setup.menu: change that script or its
// rules, not this file. See docs/japlus/ui.md.
{
	menuDef
	{
		name					"setup_menu"
		fullScreen				1
		rect					0 0 640 480
		visible					0
		focusColor				0.43 0.83 1 1
		appearanceIncrement		75
		descX					40
		descY					80
		descScale				0.8
		descColor				0.60 0.69 0.78 1
		descAlignment			ITEM_ALIGN_LEFT
		onOpen
		{
			uiScript getvideosetup
			show setup_background
			show video
			hide applyChanges
			hide video2
			hide vidrestart
			hide sound
			hide voicechat
			hide botmode
			hide options
			hide mods
			hide defaults
			hide highlights
			setitemcolor setup_submenu forecolor 0.86 0.92 0.97 1
			setitemcolor video1menubutton forecolor 0.43 0.83 1 1
		}
		onESC
		{
			play "sound/interface/button1.wav"
			defer VideoSetup videowarningMenu
			close all
			open mainMenu
		}

