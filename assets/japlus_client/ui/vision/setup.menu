			textalign				ITEM_ALIGN_CENTER
			textalignx				60
			textaligny				-0.5
			descText				@MENUS_DO_NOT_RESET_DEFAULT
			forecolor				0.86 0.92 0.97 1
			visible					0
			action
			{
				play "sound/interface/button1.wav"
				hide highlights ;
				hide default_no_button
				uiscript clearmouseover default_no ;
				close all ;
				open mainMenu ;
			}
			mouseEnter { show default_no_button }
			mouseExit { hide default_no_button }
		}

