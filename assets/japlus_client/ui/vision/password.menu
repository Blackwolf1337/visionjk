// password.menu in the new look. Made by tools/menus/build.py from ui/jamp/password.menu: change that script or its
// rules, not this file. See docs/japlus/ui.md.
{
	menuDef
	{
		name					"password_popmenu"
		visible					0
		fullscreen				0
		outOfBoundsClick
		rect					200 150 240 180
		focusColor				0.43 0.83 1 1
		style					WINDOW_STYLE_EMPTY
		descX					320
		descY					305
		descScale				0.7
		descColor				0.60 0.69 0.78 1
		descAlignment			ITEM_ALIGN_CENTER
		popup
		onESC
		{
			play "sound/interface/esc.wav" ;
			close password_popmenu
		}

		itemDef
		{
			name					vision_veil
			rect					-1200 -150 2640 480
			visible					1
			style					WINDOW_STYLE_FILLED
			backcolor				0 0.01 0.03 0.6
			decoration
		}

		itemDef
		{
			name					setup_background
			group					none
			style					WINDOW_STYLE_PANEL
			rect					0 0 240 150
			backcolor				0.035 0.07 0.12 0.94
			forecolor				1 1 1 1
			bordercolor				0.43 0.83 1 0.28
			visible					1
			decoration
			radius					8
			shadow					14
			sheen					0.08
		}

		itemDef
		{
			name					passwordTitle
			text					@MENUS_ENTER_PASSWORD
			style					WINDOW_STYLE_EMPTY
			rect					10 5 220 20
			font					5
			textscale				0.52
			textalign				ITEM_ALIGN_CENTER
			textalignx				110
			textaligny				2.75
			forecolor				0.60 0.69 0.78 1
			visible					1
			decoration
			caps					1
		}

		itemDef
		{
			name					passwordEntry
			style					WINDOW_STYLE_PANEL
			descText				@MENUS_INPUT_PASSWORD_1
			text					@MENUS_BLANK_1
			maxchars				15
			font					5
			textscale				0.69
			TYPE					4
			cvar					"password"
			rect					20 50 200 30
			textalign				ITEM_ALIGN_LEFT
			textalignx				20
			textaligny				4.2
			forecolor				0.60 0.69 0.78 1
			backcolor				0.43 0.83 1 0.14
			visible					1
			bordercolor				0 0 0 0
			mouseenter { setitemcolor passwordEntry backcolor .25 .25 .25 .75 }
			mouseexit { setitemcolor passwordEntry backcolor .25 .25 .25 .5 }
			radius					3
		}

		itemDef
		{
			name					doneText
			text					@MENUS_DONE
			descText				@MENUS_FINISHED_INPUTTING_INFO
			type					1
			font					5
			textscale				0.64
			style					WINDOW_STYLE_PANEL
			rect					65 115 110 20
			textalign				ITEM_ALIGN_CENTER
			textalignx				55
			textaligny				4
			forecolor				0.86 0.92 0.97 1
			visible					1
			action
			{
				play "sound/interface/button1.wav"
				close password_popmenu
			}
			mouseEnter
			{
				show button_glow
				setitemrect button_glow 10 113 240 26
			}
			mouseExit { hide button_glow }
			caps					1
			radius					10
			backcolor				1 1 1 0.05
			bordercolor				0.43 0.83 1 0.16
		}
		skin					1
		disableColor			0.36 0.42 0.50 1
		openSlide				8
	}
}
