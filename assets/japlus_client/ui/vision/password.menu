// password.menu in the new look. Made by tools/menus/build.py from ui/jamp/password.menu: change that script or its
// rules, not this file. See docs/japlus/ui.md.
{
	menuDef
	{
		name					"password_popmenu"
		visible					0
		fullscreen				0
		outOfBoundsClick
		rect					200 150 240 180
		focusColor				0.36 0.78 0.96 1
		style					WINDOW_STYLE_EMPTY
		descX					320
		descY					305
		descScale				0.7
		descColor				0.56 0.64 0.74 1
		descAlignment			ITEM_ALIGN_CENTER
		popup
		onESC
		{
			play "sound/interface/esc.wav" ;
			close password_popmenu
		}

		itemDef
		{
			name					vision_veil
			rect					-200 -150 640 480
			visible					1
			style					WINDOW_STYLE_FILLED
			backcolor				0 0.01 0.03 0.6
			wide					1
			decoration
		}

		itemDef
		{
			name					setup_background
			group					none
			style					WINDOW_STYLE_PANEL
			rect					0 0 240 150
			backcolor				0.031 0.055 0.11 0.97
			forecolor				1 1 1 1
			bordercolor				0.11 0.18 0.29 1
			visible					1
			decoration
			radius					6.4
			shadow					14
		}

		itemDef
		{
			name					passwordTitle
			text					@MENUS_ENTER_PASSWORD
			style					WINDOW_STYLE_EMPTY
			rect					10 5 220 20
			font					5
			textscale				0.52
			textalign				ITEM_ALIGN_CENTER
			textalignx				110
			textaligny				2.75
			forecolor				0.56 0.64 0.74 1
			visible					1
			decoration
			caps					1
		}

		itemDef
		{
			name					passwordEntry
			style					WINDOW_STYLE_PANEL
			descText				@MENUS_INPUT_PASSWORD_1
			text					@MENUS_BLANK_1
			maxchars				15
			font					5
			textscale				0.69
			TYPE					4
			cvar					"password"
			rect					20 51.2 200 18.42
			textalign				ITEM_ALIGN_LEFT
			textalignx				20
			textaligny				3
			forecolor				0.56 0.64 0.74 1
			backcolor				0.11 0.18 0.29 0.45
			visible					1
			bordercolor				0.086 0.149 0.247 1
			mouseenter { setitemcolor passwordEntry backcolor .25 .25 .25 .75 }
			mouseexit { setitemcolor passwordEntry backcolor .25 .25 .25 .5 }
			radius					3
		}

		itemDef
		{
			name					doneText
			text					@MENUS_DONE
			descText				@MENUS_FINISHED_INPUTTING_INFO
			type					1
			font					5
			textscale				0.64
			style					WINDOW_STYLE_PANEL
			rect					65 115 110 20
			textalign				ITEM_ALIGN_CENTER
			textalignx				55
			textaligny				4
			forecolor				0.86 0.90 0.945 1
			visible					1
			action
			{
				play "sound/interface/button1.wav"
				close password_popmenu
			}
			mouseEnter
			{
				show button_glow
				setitemrect button_glow 10 113 240 26
			}
			mouseExit { hide button_glow }
			caps					1
			radius					3.2
			backcolor				0 0 0 0
			bordercolor				0.153 0.251 0.373 1
		}
		skin					1
		disableColor			0.40 0.47 0.56 1
		openSlide				8
	}
}
