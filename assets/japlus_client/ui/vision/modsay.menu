// modsay.menu in the new look. Made by tools/menus/build.py from ui/jamp/modsay.menu: change that script or its
// rules, not this file. See docs/japlus/ui.md.
{
	menuDef
	{
		name					"modsay"
		visible					1
		fullscreen				0
		outOfBoundsClick
		rect					20 25 604 440
		focusColor				0.36 0.78 0.96 1
		style					WINDOW_STYLE_EMPTY
		descX					322
		descY					218
		descScale				0.7
		descColor				0.56 0.64 0.74 1
		descAlignment			ITEM_ALIGN_CENTER

		itemDef
		{
			name					background_pic
			group					none
			style					WINDOW_STYLE_PANEL
			rect					0 0 604 188
			forecolor				1 1 1 1
			visible					1
			cvarTest				"ui_modsay"
			showCvar { "1" ; "3" }
			decoration
			backcolor				0.031 0.055 0.11 0.97
			bordercolor				0.11 0.18 0.29 1
			radius					6.4
			shadow					14
		}

		itemDef
		{
			name					background_pic
			group					none
			style					WINDOW_STYLE_PANEL
			rect					0 0 600 80
			forecolor				1 1 1 1
			visible					1
			cvarTest				"ui_modsay"
			hideCvar { "1" ; "3" }
			decoration
			backcolor				0.016 0.031 0.063 0.45
			bordercolor				0.086 0.149 0.247 1
			radius					5
		}

		itemDef
		{
			name					modsaytitle
			style					WINDOW_STYLE_EMPTY
			text					"Say Mod"
			rect					20 5 340 15
			textalign				ITEM_ALIGN_CENTER
			textalignx				170
			textaligny				0
			outlinecolor			1 .5 .5 .5
			backcolor				0 0 0 0
			font					5
			textscale				0.59
			forecolor				0.56 0.64 0.74 1
			border					0
			bordercolor				0.086 0.149 0.247 1
			visible					1
			caps					1
		}

		itemDef
		{
			name					modsayType
			group					none
			type					ITEM_TYPE_MULTI
			text					""
			descText				"select the type of modSay"
			cvar					"ui_modsay"
			cvarFloatList
			{
				"Clan Say (clansay)" 0
				"Private Say (tell)" 1
				"Admin Say (amsay)" 2
				"Admin Print (ampsay)" 3
			}
			rect					10 30 150 14
			textalign				ITEM_ALIGN_RIGHT
			textalignx				0
			textaligny				1
			font					5
			textscale				0.68
			forecolor				0.56 0.64 0.74 1
			visible					1
			action { play "sound/interface/button1.wav" ; }
			mouseenter { show highlight1 }
			mouseexit { hide highlight1 }
		}

		itemDef
		{
			name					modsayAllPlayers
			group					none
			type					ITEM_TYPE_MULTI
			text					"To"
			descText				"send messages to all players?"
			cvar					"ui_modsayAllPlayer"
			cvarFloatList
			{
				"selected player" 0
				"all players" 1
			}
			rect					165 30 150 14
			textalign				ITEM_ALIGN_RIGHT
			textalignx				20
			textaligny				1
			font					5
			textscale				0.68
			forecolor				0.56 0.64 0.74 1
			visible					1
			cvarTest				"ui_modsay"
			showCvar { "3" }
			action { play "sound/interface/button1.wav" ; }
			mouseenter { show highlight3 }
			mouseexit { hide highlight3 }
		}

		itemDef
		{
			name					saySendButton
			text					@MENUS_DONE
			descText				"send the message"
			type					1
			group					none
			style					WINDOW_STYLE_EMPTY
			rect					320 20 80 30
			textalign				ITEM_ALIGN_CENTER
			textalignx				40
			textaligny				2.5
			font					5
			textscale				0.74
			forecolor				0.86 0.90 0.945 1
			visible					1
			action
			{
				play "sound/interface/button1.wav" ;
				uiScript sendModSayMsg ;
				uiScript closeingame
			}
			mouseEnter { show doneButton }
			mouseExit { hide doneButton }
			caps					1
		}

		itemDef
		{
			name					textToSend
			type					ITEM_TYPE_EDITFIELD
			style					WINDOW_STYLE_PANEL
			text					"Text:"
			cvar					"ui_modSayText"
			maxchars				133
			rect					10 50.6 570 11.76
			textalign				ITEM_ALIGN_LEFT
			textalignx				0
			textaligny				3
			font					5
			textscale				0.32
			forecolor				0.86 0.90 0.945 1
			outlinecolor			1 .5 .5 .5
			backcolor				0 0 0 0
			bordercolor				0.086 0.149 0.247 1
			descText				"Write your Text here"
			visible					1
			action { play "sound/interface/button1" }
			mouseenter
			{
				hide highlight2
				setitemcolor textToSend bordercolor 0.086 0.149 0.247 1
			}
			mouseexit
			{
				show highlight2
				setitemcolor textToSend bordercolor 0.086 0.149 0.247 1
			}
			radius					5
		}

		itemDef
		{
			name					playerList
			group					none
			descText				"Select a player"
			rect					10 70 230 108
			style					WINDOW_STYLE_PANEL
			type					ITEM_TYPE_LISTBOX
			elementwidth			120
			elementheight			15
			elementtype				LISTBOX_TEXT
			feeder					FEEDER_PLAYER_LIST
			bordercolor				0.086 0.149 0.247 1
			backcolor				0.027 0.051 0.102 0.9
			outlinecolor			0.36 0.78 0.96 0.22
			font					5
			textaligny				13.2
			textscale				0.69
			forecolor				0.56 0.64 0.74 1
			visible					1
			cvarTest				"ui_modsay"
			showCvar { "1" ; "3" }
			mouseEnter
			{
				fadein message_arena ;
				setitemcolor playerList bordercolor 0.086 0.149 0.247 1
			}
			mouseExit
			{
				fadeout message_arena ;
				setitemcolor playerList bordercolor 0.086 0.149 0.247 1
			}
			action { play "sound/interface/button1.wav" ; }
			radius					4
		}
		skin					1
		disableColor			0.40 0.47 0.56 1
		openSlide				8
	}
}
