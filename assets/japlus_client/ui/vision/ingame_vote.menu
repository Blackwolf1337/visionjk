// ingame_vote.menu in the new look. Made by tools/menus/build.py from ui/jamp/ingame_vote.menu: change that script or its
// rules, not this file. See docs/japlus/ui.md.
{
	menuDef
	{
		name					"ingame_vote"
		visible					0
		fullscreen				0
		outOfBoundsClick
		rect					430 40 82 74
		focusColor				0.43 0.83 1 1
		style					WINDOW_STYLE_EMPTY

		itemDef
		{
			name					background_pic
			group					none
			style					WINDOW_STYLE_PANEL
			rect					0 0 82 74
			forecolor				1 1 1 1
			visible					1
			decoration
			backcolor				0.035 0.07 0.12 0.94
			bordercolor				0.43 0.83 1 0.28
			radius					8
			shadow					14
			sheen					0.08
		}

		itemDef
		{
			name					yes
			text					@MENUS_YES
			type					1
			style					2
			rect					2 4 76 30
			textalign				ITEM_ALIGN_CENTER
			textalignx				38
			textaligny				1.5
			font					5
			textscale				0.86
			forecolor				0.86 0.92 0.97 1
			visible					1
			action
			{
				play "sound/interface/button1.wav" ;
				exec "vote yes" ;
				uiScript closeingame
			}
			mouseEnter { show button1 }
			mouseExit { hide button1 }
		}

		itemDef
		{
			name					no
			text					@MENUS_NO
			type					1
			style					2
			rect					2 34 76 30
			textalign				ITEM_ALIGN_CENTER
			textalignx				38
			textaligny				1.5
			font					5
			textscale				0.86
			forecolor				0.86 0.92 0.97 1
			visible					1
			action
			{
				play "sound/interface/button1.wav" ;
				exec "vote no" ;
				uiScript closeingame
			}
			mouseEnter { show button2 }
			mouseExit { hide button2 }
		}
		skin					1
		disableColor			0.36 0.42 0.50 1
		openSlide				8
		descX					471
		descY					119
		descAlignment			ITEM_ALIGN_CENTER
		descScale				0.7
		descColor				0.60 0.69 0.78 1
	}
}
