// quit.menu in the new look. Made by tools/menus/build.py from ui/jamp/quit.menu: change that script or its
// rules, not this file. See docs/japlus/ui.md.
{
	menuDef
	{
		name					"quitMenu"
		visible					0
		fullScreen				1
		rect					0 0 640 480
		focusColor				0.43 0.83 1 1
		appearanceIncrement		100
		descX					40
		descY					80
		descScale				0.8
		descColor				0.60 0.69 0.78 1
		descAlignment			ITEM_ALIGN_LEFT
		appearanceIncrement		100
		onESC
		{
			play "sound/interface/button1.wav" ;
			close quitMenu ;
			open mainMenu ;
		}
		onOpen { setfocus quitgame_cancel }

		itemDef
		{
			name					vision_bar
			rect					0 0 640 34
			visible					1
			style					WINDOW_STYLE_FILLED
			backcolor				0.02 0.04 0.08 0.55
			wide					1
			decoration
		}

		itemDef
		{
			name					vision_bar_line
			rect					0 34 640 0.67
			visible					1
			style					WINDOW_STYLE_FILLED
			backcolor				0.43 0.83 1 0.22
			wide					1
			decoration
		}

		itemDef
		{
			name					vision_logo
			rect					22 6 22 22
			visible					1
			type					ITEM_TYPE_LOGO
			forecolor				1 1 1 1
			decoration
		}

		itemDef
		{
			name					vision_mark
			rect					50 7 120 20
			visible					1
			text					"VISIONJK"
			font					5
			textscale				1
			forecolor				1 1 1 1
			decoration
		}

		itemDef
		{
			name					vision_mark2
			rect					138 12 160 14
			visible					1
			text					"JEDI ACADEMY"
			font					5
			textscale				0.5
			forecolor				0.60 0.69 0.78 1
			decoration
		}

		itemDef
		{
			name					newgamebutton
			group					toprow
			style					WINDOW_STYLE_EMPTY
			type					ITEM_TYPE_BUTTON
			rect					330 7 72 20
			text					@MENUS_PLAY
			descText				@MENUS_START_PLAYING_NOW
			font					5
			textscale				0.66
			textaligny				4
			textalign				ITEM_ALIGN_CENTER
			textstyle				0
			textalignx				36
			forecolor				0.86 0.92 0.97 1
			visible					1
			mouseEnter { show newgamebutton_glow }
			mouseExit { hide newgamebutton_glow }
			action
			{
				play "sound/interface/button1.wav" ;
				close all ;
				open multiplayermenu
			}
			caps					1
		}

		itemDef
		{
			name					profilebutton
			group					toprow
			text					@MENUS_PROFILE
			descText				@MENUS_PROFILE_DESC
			style					WINDOW_STYLE_EMPTY
			type					ITEM_TYPE_BUTTON
			rect					404 7 72 20
			textaligny				4
			font					5
			textscale				0.66
			textalign				ITEM_ALIGN_CENTER
			textstyle				0
			textalignx				36
			forecolor				0.86 0.92 0.97 1
			visible					1
			mouseEnter { show profilebutton_glow }
			mouseExit { hide profilebutton_glow }
			action
			{
				play "sound/interface/button1.wav" ;
				close all ;
				open playerMenu
			}
			caps					1
		}

		itemDef
		{
			name					controlsbutton
			group					toprow
			text					@MENUS_CONTROLS2
			descText				@MENUS_CONFIGURE_GAME_CONTROLS
			type					ITEM_TYPE_BUTTON
			style					WINDOW_STYLE_EMPTY
			rect					478 7 72 20
			font					5
			textscale				0.66
			textaligny				4
			textalign				ITEM_ALIGN_CENTER
			textstyle				0
			textalignx				36
			backcolor				0 0 0 0
			forecolor				0.86 0.92 0.97 1
			visible					1
			mouseEnter { show controlsbutton_glow }
			mouseExit { hide controlsbutton_glow }
			action
			{
				play "sound/interface/button1.wav" ;
				close all ;
				open controlsMenu ;
			}
			caps					1
		}

		itemDef
		{
			name					setupbutton
			group					toprow
			text					@MENUS_SETUP
			descText				@MENUS_CONFIGURE_GAME_SETTINGS
			type					ITEM_TYPE_BUTTON
			style					WINDOW_STYLE_EMPTY
			rect					552 7 72 20
			font					5
			textscale				0.66
			textaligny				4
			textalign				ITEM_ALIGN_CENTER
			textstyle				0
			textalignx				36
			backcolor				0 0 0 0
			forecolor				0.86 0.92 0.97 1
			visible					1
			mouseEnter { show setupbutton_glow }
			mouseExit { hide setupbutton_glow }
			action
			{
				play "sound/interface/button1.wav" ;
				close all ;
				open setup_menu
			}
			caps					1
		}

		itemDef
		{
			name					creditsbutton
			group					othermain
			descText				@MENUS_SHOW_GAME_CREDITS
			type					ITEM_TYPE_BUTTON
			style					WINDOW_STYLE_EMPTY
			rect					200 144 256 256
			font					2
			textscale				1
			textaligny				0
			textalign				ITEM_ALIGN_CENTER
			textalignx				46
			backcolor				0 0 0 0
			forecolor				0.65 0.65 1 1
			visible					0
			mouseEnter {  }
			mouseExit {  }
			action
			{
				play "sound/interface/button1.wav" ;
				close all ;
				open creditsMenu
			}
		}

		itemDef
		{
			name					quit_title
			group					none
			text					@MENUS_LEAVING_JEDI_KNIGHT_2
			style					WINDOW_STYLE_EMPTY
			rect					40 46 400 28
			font					5
			textscale				1.45
			textalign				ITEM_ALIGN_LEFT
			textalignx				0
			textaligny				2
			forecolor				1 1 1 1
			visible					1
			decoration
			caps					1
		}

		itemDef
		{
			name					confirm
			group					none
			text					@MENUS_QUIT_JEDI_KNIGHT_II
			font					5
			textscale				0.86
			textstyle				0
			rect					40 100 450 20
			textalign				ITEM_ALIGN_CENTER
			textalignx				225
			textaligny				1.5
			decoration
			forecolor				0.86 0.92 0.97 1
			visible					1
		}
		skin					1
		disableColor			0.36 0.42 0.50 1
		backdrop				1

		itemDef
		{
			name					quitgame_cancel
			group					none
			text					@MENUS_NO
			type					ITEM_TYPE_BUTTON
			style					WINDOW_STYLE_PANEL
			rect					40 446 110 22
			font					5
			textscale				0.7
			textalignx				55
			textaligny				4.5
			textalign				ITEM_ALIGN_CENTER
			textstyle				0
			descText				@MENUS_DO_NOT_LEAVE_JEDI_KNIGHT
			forecolor				0.86 0.92 0.97 1
			visible					1
			action
			{
				play "sound/interface/button1.wav" ;
				close quitMenu ;
				open mainMenu ;
			}
			mouseEnter { show quitgame_cancel_button }
			mouseExit { hide quitgame_cancel_button }
			caps					1
			backcolor				1 1 1 0.04
			bordercolor				0.43 0.83 1 0.16
			radius					11
		}

		itemDef
		{
			name					quitgame_yes
			group					none
			text					@MENUS_YES
			type					ITEM_TYPE_BUTTON
			style					WINDOW_STYLE_PANEL
			rect					490 446 110 22
			font					5
			textscale				0.7
			textalignx				55
			textaligny				4.5
			textalign				ITEM_ALIGN_CENTER
			textstyle				0
			descText				@MENUS_JEDI_KNIGHT_II
			forecolor				1 1 1 1
			visible					1
			action
			{
				play "sound/interface/button1.wav" ;
				uiScript Quit
			}
			mouseEnter { show quitgame_yes_button }
			mouseExit { hide quitgame_yes_button }
			caps					1
			backcolor				0.43 0.83 1 0.20
			bordercolor				0.43 0.83 1 0.75
			radius					11
		}
	}
}
