			text					@MENUS_APPLY_POWERS
			type					1
			style					WINDOW_STYLE_EMPTY
			rect					140 370 150 32
			textalign				1
			textalignx				75
			textaligny				3.5
			font					5
			textscale				0.86
			forecolor				0.86 0.92 0.97 1
			descText				@MENUS_MAKE_THESE_CHANGES_TO
			visible					1
			action
			{
				play "sound/interface/button1.wav" ;
				uiScript setForce "same"
				close ingame_playerforce ;
				open ingame_player
			}
			mouseEnter { show applyjoinbutton }
			mouseExit { hide applyjoinbutton }
		}
