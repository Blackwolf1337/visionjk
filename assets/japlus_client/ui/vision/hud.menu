// The HUD of the new look: two menus the cgame paints at the left and at the right edge of the window, made of
// items that show a number of the game (ITEM_TYPE_BAR, ITEM_TYPE_VALUE, "stat", "showStat") and of panels.
// Written by hand, not by tools/menus/build.py. Everything here can be moved, recoloured or taken out: the
// names of the numbers are in docs/japlus/ui.md. v_hud 0 brings the HUD of the game back.
#include "ui/jamp/menudef.h"
{
	menuDef
	{
		name					"visionhud_left"
		fullScreen				0
		rect					0 0 640 480
		visible					1
		skin					1

		itemDef
		{
			name				panel
			rect				10 426 178 44
			style				WINDOW_STYLE_PANEL
			backcolor			0.035 0.07 0.12 0.62
			bordercolor			0.43 0.83 1 0.22
			radius				7
			frosted				0.65		// frosted glass behind it (v_backdropBlur), the panel this much as opaque then
			shadow				8
			showStat			alive
			visible				1
			decoration
		}
		// health: the number, and a bar that turns amber and then red
		itemDef
		{
			name				health_value
			type				ITEM_TYPE_VALUE
			rect				14 429 40 20
			stat				health
			showStat			alive
			font				5
			textscale			1.05
			textalign			ITEM_ALIGN_RIGHT
			textalignx			36
			textaligny			0
			forecolor			1 1 1 1
			addColorRange		0 25 1 0.38 0.33 1
			addColorRange		26 50 1 0.74 0.30 1
			visible				1
			decoration
		}
		itemDef
		{
			name				health_bar
			type				ITEM_TYPE_BAR
			rect				58 435 124 6
			stat				health
			showStat			alive
			forecolor			0.42 0.90 0.62 1
			backcolor			1 1 1 0.10
			addColorRange		0 25 1 0.38 0.33 1
			addColorRange		26 50 1 0.74 0.30 1
			visible				1
			decoration
		}
		// shield
		itemDef
		{
			name				armor_value
			type				ITEM_TYPE_VALUE
			rect				14 448 40 12
			stat				armor
			showStat			alive
			font				5
			textscale			0.62
			textalign			ITEM_ALIGN_RIGHT
			textalignx			36
			textaligny			0
			forecolor			0.43 0.83 1 1
			visible				1
			decoration
		}
		itemDef
		{
			name				armor_bar
			type				ITEM_TYPE_BAR
			rect				58 451 124 4
			stat				armor
			showStat			alive
			forecolor			0.43 0.83 1 1
			backcolor			1 1 1 0.10
			visible				1
			decoration
		}
	}

	menuDef
	{
		name					"visionhud_right"
		fullScreen				0
		rect					0 0 640 480
		visible					1
		skin					1

		itemDef
		{
			name				panel
			rect				452 426 178 44
			style				WINDOW_STYLE_PANEL
			backcolor			0.035 0.07 0.12 0.62
			bordercolor			0.43 0.83 1 0.22
			radius				7
			frosted				0.65		// frosted glass behind it (v_backdropBlur), the panel this much as opaque then
			shadow				8
			showStat			alive
			visible				1
			decoration
		}
		// where C draws (hud/cg_hudpanels.c): the slot of the selected force power (the weapon without force), and
		// the name of the weapon under its bar
		itemDef
		{
			name				force_slot
			rect				456 430 36 36
			visible				1
			decoration
		}
		itemDef
		{
			name				weapon_label
			rect				498 457 90 9
			visible				1
			decoration
		}
		// the force: a bar that is filled from the right
		itemDef
		{
			name				force_bar
			type				ITEM_TYPE_BAR
			rect				498 436 90 6
			stat				force
			showStat			alive
			align				ITEM_ALIGN_RIGHT
			forecolor			0.58 0.64 1 1
			backcolor			1 1 1 0.10
			visible				1
			decoration
		}
		itemDef
		{
			name				force_value
			type				ITEM_TYPE_VALUE
			rect				593 429 34 20
			stat				force
			showStat			alive
			font				5
			textscale			1.05
			textalign			ITEM_ALIGN_LEFT
			textalignx			0
			textaligny			0
			forecolor			1 1 1 1
			visible				1
			decoration
		}
		// what is in the weapon, or how the saber is held
		itemDef
		{
			name				ammo_bar
			type				ITEM_TYPE_BAR
			rect				498 451 90 4
			stat				ammo
			showStat			ammo
			align				ITEM_ALIGN_RIGHT
			forecolor			1 0.74 0.30 1
			backcolor			1 1 1 0.10
			visible				1
			decoration
		}
		itemDef
		{
			name				ammo_value
			type				ITEM_TYPE_VALUE
			rect				593 448 34 12
			stat				ammo
			showStat			ammo
			font				5
			textscale			0.62
			textalign			ITEM_ALIGN_LEFT
			textalignx			0
			textaligny			0
			forecolor			1 0.74 0.30 1
			visible				1
			decoration
		}
		itemDef
		{
			name				style_bar
			type				ITEM_TYPE_BAR
			rect				498 451 90 4
			stat				saberstyle
			showStat			saberstyle
			align				ITEM_ALIGN_RIGHT
			forecolor			0.43 0.83 1 1
			backcolor			1 1 1 0.10
			addColorRange		1 1 0.43 0.83 1 1
			addColorRange		2 2 1 0.92 0.45 1
			addColorRange		3 7 1 0.38 0.33 1
			visible				1
			decoration
		}
		itemDef
		{
			name				style_label
			rect				593 448 34 12
			text				@VISION_SABER
			caps				1
			showStat			saberstyle
			font				5
			textscale			0.5
			textaligny			1
			forecolor			0.60 0.69 0.78 1
			visible				1
			decoration
		}
	}
}
