// findplayer.menu in the new look. Made by tools/menus/build.py from ui/jamp/findplayer.menu: change that script or its
// rules, not this file. See docs/japlus/ui.md.
{
	menuDef
	{
		name					"findplayer_popmenu"
		visible					0
		fullscreen				0
		outOfBoundsClick
		rect					460 110 680 680
		focusColor				0.36 0.78 0.96 1
		style					WINDOW_STYLE_EMPTY
		descX					800
		descY					804
		descScale				0.78
		descColor				0.56 0.64 0.74 1
		descAlignment			ITEM_ALIGN_CENTER
		popup
		onOpen
		{
			uiScript FindPlayer
			setfocus nameField
		}
		onESC
		{
			play "sound/interface/esc.wav" ;
			close findplayer_popmenu
		}
		skin					1
		disableColor			0.40 0.47 0.56 1
		openSlide				8
		backcolor				0.031 0.055 0.11 0.86
		bordercolor				0.11 0.18 0.29 1
		radius					6.4
		shadow					14

		itemDef
		{
			name					vision_veil
			rect					-460 -110 1600 900
			visible					1
			style					WINDOW_STYLE_FILLED
			backcolor				0 0 0 0.55
			decoration
			wide					1
		}

		itemDef
		{
			name					vision_dialog
			rect					0 0 680 680
			visible					1
			style					WINDOW_STYLE_PANEL
			backcolor				0.039 0.071 0.133 0.96
			bordercolor				0.153 0.251 0.373 1
			radius					12
			decoration
			shadow					40
		}

		itemDef
		{
			name					screenTitle
			text					@MENUS_FIND_PLAYER
			style					WINDOW_STYLE_EMPTY
			rect					28 24 624 34
			font					5
			textscale				1.33
			textalign				ITEM_ALIGN_LEFT
			textalignx				0
			textaligny				5
			forecolor				1 1 1 1
			visible					1
			decoration
		}

		itemDef
		{
			name					nameEntry
			style					WINDOW_STYLE_EMPTY
			descText				@MENUS_INPUT_PLAYER_NAME
			text					@MENUS_NAME1
			maxchars				15
			font					5
			textscale				0.89
			type					ITEM_TYPE_EDITFIELD
			cvar					"ui_findplayer"
			rect					28 70 624 44
			textalign				ITEM_ALIGN_LEFT
			textalignx				5
			textaligny				1.35
			forecolor				0.56 0.64 0.74 1
			backcolor				0.11 0.18 0.29 0.45
			bordercolor				0.086 0.149 0.247 1
			visible					1
			action { ui_script FindPlayer }
			mouseenter { setitemcolor nameEntry backcolor .25 .25 .25 .75 }
			mouseexit { setitemcolor nameEntry backcolor .25 .25 .25 .5 }
			radius					3
			row						3
		}

		itemDef
		{
			name					serverNameList
			rect					28 126 624 140
			type					ITEM_TYPE_LISTBOX
			style					WINDOW_STYLE_PANEL
			elementwidth			120
			elementheight			16
			font					5
			textscale				0.78
			backcolor				0.027 0.051 0.102 1
			outlinecolor			0.36 0.78 0.96 0.22
			bordercolor				0.153 0.251 0.373 1
			elementtype				LISTBOX_TEXT
			feeder					FEEDER_FINDPLAYER
			visible					1
			textaligny				13.2
			mouseenter { setitemcolor serverNameWindow bordercolor 0.086 0.149 0.247 1 }
			mouseexit { setitemcolor serverNameWindow bordercolor 0.086 0.149 0.247 1 }
			radius					6
		}

		itemDef
		{
			name					serverInfoList
			rect					28 278 624 230
