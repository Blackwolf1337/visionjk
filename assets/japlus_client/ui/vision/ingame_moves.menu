// ingame_moves.menu in the new look. Made by tools/menus/build.py from ui/jamp/ingame_moves.menu: change that script or its
// rules, not this file. See docs/japlus/ui.md.
{
	menuDef
	{
		name					"rulesMenu_moves"
		visible					0
		fullscreen				0
		outOfBoundsClick
		rect					20 25 604 450
		focusColor				0.36 0.78 0.96 1
		style					WINDOW_STYLE_EMPTY
		descX					322
		descY					10
		descScale				0.7
		descColor				0.56 0.64 0.74 1
		descAlignment			ITEM_ALIGN_CENTER
		onESC
		{
			play "sound/interface/esc.wav"
			close "ingame_moves" ;
			open "ingame_player" ;
		}
		onOpen
		{
			setcvar "ui_movesflag" 0
			setcvar "ui_move_title" 2
			uiScript setMoveCharacter
			uiScript setMovesListDefault
		}

		itemDef
		{
			name					background_pic
			group					none
			style					WINDOW_STYLE_PANEL
			rect					0 0 604 450
			forecolor				1 1 1 1
			visible					1
			decoration
			backcolor				0.031 0.055 0.11 0.97
			bordercolor				0.11 0.18 0.29 1
			radius					6.4
			shadow					14
		}

		itemDef
		{
			name					background
			group					none
			style					WINDOW_STYLE_PANEL
			rect					0 420 600 20
			backcolor				0.11 0.18 0.29 0.45
			forecolor				.549 .854 1 1
			visible					1
			decoration
			bordercolor				0.086 0.149 0.247 1
			radius					3
		}

		itemDef
		{
			name					game_rulesheader
			group					rulesheader
			style					WINDOW_STYLE_EMPTY
			text					@MENUS_MOVES
			rect					100 5 440 24
			font					5
			textscale				0.74
			textalign				ITEM_ALIGN_CENTER
			textalignx				225
			textaligny				1.5
			forecolor				0.56 0.64 0.74 1
			visible					1
			decoration
			caps					1
		}

		itemDef
		{
			name					move_titles_box
			group					none
			style					WINDOW_STYLE_PANEL
			rect					5 47 255 23
			backcolor				0.11 0.18 0.29 0.45
			visible					1
			decoration
			bordercolor				0.086 0.149 0.247 1
			radius					3
		}

		itemDef
		{
			name					move_titles_outline
			group					none
			style					WINDOW_STYLE_PANEL
			rect					4 68 255 30
			bordercolor				0.086 0.149 0.247 1
			visible					1
			decoration
			backcolor				0 0 0 0
			radius					5
		}

		itemDef
		{
			name					move_titles_title
			type					ITEM_TYPE_TEXT
			rect					5 47 255 23
			text					@MENUS_MOVE_TYPES
			font					5
			forecolor				0.56 0.64 0.74 1
			textscale				0.74
			textalign				ITEM_ALIGN_CENTER
			textalignx				125
			visible					1
			decoration
			caps					1
			textaligny				4.84
		}

		itemDef
		{
			name					move_titles
			group					none
			text					" "
			descText				@MENUS_CHOOSE_MOVE_DESC
			type					ITEM_TYPE_MULTI
			style					WINDOW_STYLE_EMPTY
			rect					5 77 340 14
			font					5
			textscale				0.69
			textaligny				-3.8
			textalign				ITEM_ALIGN_LEFT
			textstyle				.8
			textalignx				0
			backcolor				0 0 0 0
			forecolor				0.56 0.64 0.74 1
			feeder					42
			cvar					"ui_move_title"
			cvarFloatList
			{
				"@MENUS_ACROBATICS" 0
				"@MENUS_SINGLE_FAST" 1
				"@MENUS_SINGLE_MEDIUM" 2
				"@MENUS_SINGLE_STRONG" 3
				"@MENUS_DUAL_SABERS" 4
				"@MENUS_SABER_STAFF" 5
				"Melee & others attacks" 6
			}
			visible					1
			mouseEnter
			{
				show button_glow
				setitemrect button_glow 0 73 320 24
			}
			mouseExit { hide button_glow }
			action
			{
				uiScript resetMovesList
				play "sound/interface/button1.wav"
			}
		}

		itemDef
		{
			name					moveslist_title_box
			group					none
			style					WINDOW_STYLE_PANEL
			rect					6 110 253 23
			backcolor				0.11 0.18 0.29 0.45
			visible					1
			decoration
			bordercolor				0.086 0.149 0.247 1
			radius					3
		}

		itemDef
		{
			name					moveslist_title
			type					ITEM_TYPE_TEXT
			rect					15 108 253 26
			text					@MENUS_MOVES
			font					5
			forecolor				0.56 0.64 0.74 1
			textscale				0.74
			textalign				ITEM_ALIGN_CENTER
			textalignx				125
			visible					1
			decoration
			caps					1
			textaligny				6.84
		}

		itemDef
		{
			name					moveslist
			group					none
			rect					5 130 253 250
			type					ITEM_TYPE_LISTBOX
			style					WINDOW_STYLE_PANEL
			elementwidth			120
			elementheight			16
			font					5
			textscale				0.6
			bordercolor				0.086 0.149 0.247 1
			forecolor				0.56 0.64 0.74 1
			backcolor				0.027 0.051 0.102 0.9
			outlinecolor			0.36 0.78 0.96 0.22
			elementtype				LISTBOX_TEXT
			feeder					41
			desctext				@MENUS_MOVE_DESC2
			notselectable
			visible					1
			columns					1 2 55 225
			mouseEnter { setitemcolor moveslist bordercolor 0.36 0.78 0.96 0.6 }
			mouseExit { setitemcolor moveslist bordercolor 0.086 0.149 0.247 1 }
			doubleclick { play sound/interface/button1.wav }
			radius					4
		}

		itemDef
		{
			name					character_box
			group					none
			style					WINDOW_STYLE_PANEL
			rect					265 38 330 370
			bordercolor				0.086 0.149 0.247 1
			visible					1
			decoration
			backcolor				0 0 0 0
			radius					5
		}

		itemDef
		{
			name					character
			group					models
			type					ITEM_TYPE_MODEL
			rect					275 -30 300 340
			model_g2anim			"BOTH_ROLL_F"
			asset_model				"ui_char_model"
			model_angle				180
			model_g2mins			-20 -15 -10
			model_g2maxs			20 15 45
			model_rotation			50
			model_fovx				50
			model_fovy				50
			isCharacter				1
			isSaber					1
			visible					1
			decoration
		}

		itemDef
		{
			name					item_desc
			type					ITEM_TYPE_TEXTSCROLL
			rect					275 300 320 90
			text					"  "
			cvar					ui_move_desc
			font					5
			forecolor				0.56 0.64 0.74 1
			textscale				0.68
			textalign				ITEM_ALIGN_LEFT
			textaligny				7
			visible					1
			lineHeight				13
			outlinecolor			0.36 0.78 0.96 0.22
		}

		itemDef
		{
			name					backbutton
			group					fade_buttons
			text					@MENUS_BACK
			descText				"Back to player config"
			type					ITEM_TYPE_BUTTON
			style					WINDOW_STYLE_PANEL
			rect					49 416 110 20
			font					5
			textscale				0.64
			textalign				ITEM_ALIGN_CENTER
			textstyle				0
			textalignx				55
			textaligny				4
			forecolor				0.86 0.90 0.945 1
			visible					1
			mouseEnter
			{
				show button_glow
				setitemrect button_glow 30 441 190 30
			}
			mouseExit { hide button_glow }
			action
			{
				play "sound/interface/esc.wav" ;
				close rulesMenu_moves ;
				open ingame_player
			}
			caps					1
			radius					3.2
			backcolor				0 0 0 0
			bordercolor				0.153 0.251 0.373 1
		}

		itemDef
		{
			name					exitgamebutton
			group					othermain
			text					@MENUS_EXIT
			descText				"Quit this menu"
			type					ITEM_TYPE_BUTTON
			style					WINDOW_STYLE_PANEL
			rect					245 416 110 20
			font					5
			textscale				0.64
			textalign				ITEM_ALIGN_CENTER
			textstyle				0
			textalignx				55
			textaligny				4
			forecolor				0.86 0.90 0.945 1
			visible					1
			mouseEnter { show exitgamebutton_glow }
			mouseExit { hide exitgamebutton_glow }
			action
			{
				play "sound/weapons/saber/saberoff.mp3" ;
				close all ;
			}
			caps					1
			radius					3.2
			backcolor				0 0 0 0
			bordercolor				0.153 0.251 0.373 1
		}
		skin					1
		disableColor			0.40 0.47 0.56 1
		openSlide				8
	}
}
