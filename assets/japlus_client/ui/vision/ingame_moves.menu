// ingame_moves.menu in the new look. Made by tools/menus/build.py from ui/jamp/ingame_moves.menu: change that script or its
// rules, not this file. See docs/japlus/ui.md.
{
	menuDef
	{
		name					"rulesMenu_moves"
		visible					0
		fullscreen				0
		outOfBoundsClick
		rect					200 50 1208 900
		focusColor				0.36 0.78 0.96 1
		style					WINDOW_STYLE_EMPTY
		descX					804
		descY					20
		descScale				1.4
		descColor				0.56 0.64 0.74 1
		descAlignment			ITEM_ALIGN_CENTER
		onESC
		{
			play "sound/interface/esc.wav"
			close "ingame_moves" ;
			open "ingame_player" ;
		}
		onOpen
		{
			setcvar "ui_movesflag" 0
			setcvar "ui_move_title" 2
			uiScript setMoveCharacter
			uiScript setMovesListDefault
		}
		skin					1
		disableColor			0.40 0.47 0.56 1
		openSlide				8

		itemDef
		{
			name					background_pic
			group					none
			style					WINDOW_STYLE_PANEL
			rect					0 0 1208 900
			forecolor				1 1 1 1
			visible					1
			decoration
			backcolor				0.031 0.055 0.11 0.97
			bordercolor				0.11 0.18 0.29 1
			radius					12.8
			shadow					28
		}

		itemDef
		{
			name					background
			group					none
			style					WINDOW_STYLE_PANEL
			rect					0 840 1200 40
			backcolor				0.11 0.18 0.29 0.45
			forecolor				.549 .854 1 1
			visible					1
			decoration
			bordercolor				0.086 0.149 0.247 1
			radius					6
		}

		itemDef
		{
			name					game_rulesheader
			group					rulesheader
			style					WINDOW_STYLE_EMPTY
			text					@MENUS_MOVES
			rect					200 10 880 48
			font					5
			textscale				1.48
			textalign				ITEM_ALIGN_CENTER
			textalignx				450
			textaligny				3
			forecolor				0.56 0.64 0.74 1
			visible					1
			decoration
			caps					1
		}

		itemDef
		{
			name					move_titles_box
			group					none
			style					WINDOW_STYLE_PANEL
			rect					10 94 510 46
			backcolor				0.11 0.18 0.29 0.45
			visible					1
			decoration
			bordercolor				0.086 0.149 0.247 1
			radius					6
		}

		itemDef
		{
			name					move_titles_outline
			group					none
			style					WINDOW_STYLE_PANEL
			rect					8 136 510 60
			bordercolor				0.086 0.149 0.247 1
			visible					1
			decoration
			backcolor				0 0 0 0
			radius					10
		}

		itemDef
		{
			name					move_titles_title
			type					ITEM_TYPE_TEXT
			rect					10 94 510 46
			text					@MENUS_MOVE_TYPES
			font					5
			forecolor				0.56 0.64 0.74 1
			textscale				1.48
			textalign				ITEM_ALIGN_CENTER
			textalignx				250
			visible					1
			decoration
			caps					1
			textaligny				9.68
		}

		itemDef
		{
			name					move_titles
			group					none
			text					" "
			descText				@MENUS_CHOOSE_MOVE_DESC
			type					ITEM_TYPE_MULTI
			style					WINDOW_STYLE_EMPTY
			rect					10 154 680 28
			font					5
			textscale				1.38
			textaligny				-7.6
			textalign				ITEM_ALIGN_LEFT
			textstyle				.8
			textalignx				0
			backcolor				0 0 0 0
			forecolor				0.56 0.64 0.74 1
			feeder					42
			cvar					"ui_move_title"
			cvarFloatList
			{
				"@MENUS_ACROBATICS" 0
				"@MENUS_SINGLE_FAST" 1
				"@MENUS_SINGLE_MEDIUM" 2
				"@MENUS_SINGLE_STRONG" 3
				"@MENUS_DUAL_SABERS" 4
				"@MENUS_SABER_STAFF" 5
				"Melee & others attacks" 6
			}
			visible					1
			mouseEnter
			{
				show button_glow
				setitemrect button_glow 0 73 320 24
			}
			mouseExit { hide button_glow }
			action
			{
				uiScript resetMovesList
				play "sound/interface/button1.wav"
			}
		}

		itemDef
		{
			name					moveslist_title_box
			group					none
			style					WINDOW_STYLE_PANEL
			rect					12 220 506 46
			backcolor				0.11 0.18 0.29 0.45
			visible					1
			decoration
			bordercolor				0.086 0.149 0.247 1
			radius					6
		}

		itemDef
		{
			name					moveslist_title
			type					ITEM_TYPE_TEXT
			rect					30 216 506 52
			text					@MENUS_MOVES
			font					5
			forecolor				0.56 0.64 0.74 1
			textscale				1.48
			textalign				ITEM_ALIGN_CENTER
			textalignx				250
			visible					1
			decoration
			caps					1
			textaligny				13.68
		}

		itemDef
		{
			name					moveslist
			group					none
			rect					10 260 506 500
			type					ITEM_TYPE_LISTBOX
			style					WINDOW_STYLE_PANEL
			elementwidth			240
			elementheight			32
			font					5
			textscale				1.2
			bordercolor				0.086 0.149 0.247 1
			forecolor				0.56 0.64 0.74 1
			backcolor				0.027 0.051 0.102 0.9
			outlinecolor			0.36 0.78 0.96 0.22
			elementtype				LISTBOX_TEXT
			feeder					41
			desctext				@MENUS_MOVE_DESC2
			notselectable
			visible					1
			columns					1 4 55 450
			mouseEnter { setitemcolor moveslist bordercolor 0.36 0.78 0.96 0.6 }
			mouseExit { setitemcolor moveslist bordercolor 0.086 0.149 0.247 1 }
			doubleclick { play sound/interface/button1.wav }
			radius					8
		}

		itemDef
		{
			name					character_box
			group					none
			style					WINDOW_STYLE_PANEL
			rect					530 76 660 740
			bordercolor				0.086 0.149 0.247 1
			visible					1
			decoration
			backcolor				0 0 0 0
			radius					10
		}

		itemDef
		{
			name					character
			group					models
			type					ITEM_TYPE_MODEL
			rect					550 -60 600 680
			model_g2anim			"BOTH_ROLL_F"
			asset_model				"ui_char_model"
			model_angle				180
			model_g2mins			-20 -15 -10
			model_g2maxs			20 15 45
			model_rotation			50
			model_fovx				50
			model_fovy				50
			isCharacter				1
			isSaber					1
			visible					1
			decoration
		}

		itemDef
		{
			name					item_desc
			type					ITEM_TYPE_TEXTSCROLL
			rect					550 600 640 180
			text					"  "
			cvar					ui_move_desc
			font					5
			forecolor				0.56 0.64 0.74 1
			textscale				1.36
			textalign				ITEM_ALIGN_LEFT
			textaligny				14
			visible					1
			lineHeight				13
			outlinecolor			0.36 0.78 0.96 0.22
		}

		itemDef
		{
			name					backbutton
			group					fade_buttons
			text					@MENUS_BACK
			descText				"Back to player config"
			type					ITEM_TYPE_BUTTON
			style					WINDOW_STYLE_PANEL
			rect					98 832 220 40
			font					5
			textscale				1.28
			textalign				ITEM_ALIGN_CENTER
			textstyle				0
			textalignx				110
			textaligny				8
			forecolor				0.86 0.90 0.945 1
			visible					1
			mouseEnter
			{
				show button_glow
				setitemrect button_glow 30 441 190 30
			}
			mouseExit { hide button_glow }
			action
			{
				play "sound/interface/esc.wav" ;
				close rulesMenu_moves ;
				open ingame_player
			}
			caps					1
			radius					6.4
			backcolor				0 0 0 0
			bordercolor				0.153 0.251 0.373 1
		}

		itemDef
		{
			name					exitgamebutton
			group					othermain
			text					@MENUS_EXIT
			descText				"Quit this menu"
			type					ITEM_TYPE_BUTTON
			style					WINDOW_STYLE_PANEL
			rect					490 832 220 40
			font					5
			textscale				1.28
			textalign				ITEM_ALIGN_CENTER
			textstyle				0
			textalignx				110
			textaligny				8
			forecolor				0.86 0.90 0.945 1
			visible					1
			mouseEnter { show exitgamebutton_glow }
			mouseExit { hide exitgamebutton_glow }
			action
			{
				play "sound/weapons/saber/saberoff.mp3" ;
				close all ;
			}
			caps					1
			radius					6.4
			backcolor				0 0 0 0
			bordercolor				0.153 0.251 0.373 1
		}
		canvas					1600 1200
	}
}
