// password_request.menu in the new look. Made by tools/menus/build.py from ui/jamp/password_request.menu: change that script or its
// rules, not this file. See docs/japlus/ui.md.
{
	menuDef
	{
		name					"password_request"
		visible					0
		fullscreen				0
		outOfBoundsClick
		rect					620 317 360 270
		focusColor				0.36 0.78 0.96 1
		style					WINDOW_STYLE_EMPTY
		descX					800
		descY					572
		descScale				1.05
		descColor				0.56 0.64 0.74 1
		descAlignment			ITEM_ALIGN_CENTER
		popup
		onESC
		{
			play "sound/interface/esc.wav" ;
			close password_request
		}
		skin					1
		disableColor			0.40 0.47 0.56 1
		openSlide				8

		itemDef
		{
			name					vision_veil
			rect					-300 -225 960 720
			visible					1
			style					WINDOW_STYLE_FILLED
			backcolor				0 0.01 0.03 0.6
			wide					1
			decoration
		}

		itemDef
		{
			name					setup_background
			group					none
			style					WINDOW_STYLE_PANEL
			rect					0 0 360 247.5
			backcolor				0.031 0.055 0.11 0.97
			forecolor				1 1 1 1
			bordercolor				0.11 0.18 0.29 1
			visible					1
			decoration
			radius					9.6
			shadow					21
		}

		itemDef
		{
			name					passwordTitle
			text					@MENUS_ENTER_PASSWORD
			style					WINDOW_STYLE_EMPTY
			rect					15 7.5 330 30
			font					5
			textscale				0.78
			textalign				ITEM_ALIGN_CENTER
			textalignx				165
			textaligny				4.12
			forecolor				0.56 0.64 0.74 1
			visible					1
			decoration
			caps					1
		}

		itemDef
		{
			name					passwordEntry
			style					WINDOW_STYLE_PANEL
			descText				@MENUS_INPUT_PASSWORD_1
			text					@MENUS_BLANK_1
			maxchars				15
			font					5
			textscale				1.03
			TYPE					4
			cvar					"password"
			rect					30 76.8 300 27.63
			textalign				ITEM_ALIGN_LEFT
			textalignx				30
			textaligny				4.5
			forecolor				0.56 0.64 0.74 1
			backcolor				0.11 0.18 0.29 0.45
			visible					1
			bordercolor				0.086 0.149 0.247 1
			mouseenter { setitemcolor passwordEntry backcolor .25 .25 .25 .75 }
			mouseexit { setitemcolor passwordEntry backcolor .25 .25 .25 .5 }
			radius					4.5
		}

		itemDef
		{
			name					doneText
			text					@MENUS_DONE
			descText				@MENUS_FINISHED_INPUTTING_INFO
			type					1
			font					5
			textscale				0.89
			style					WINDOW_STYLE_EMPTY
			rect					30 135 300 45
			textalign				ITEM_ALIGN_CENTER
			textalignx				150
			textaligny				10.5
			forecolor				0.86 0.90 0.945 1
			visible					1
			action
			{
				play "sound/interface/button1.wav"
				uiscript JoinServer
				close password_request
			}
			mouseEnter
			{
				show button_glow
				setitemrect button_glow 10 93 240 26
			}
			mouseExit { hide button_glow }
			caps					1
		}

		itemDef
		{
			name					cancel
			text					@MENUS_VC_CANCEL
			descText				@MP_SVGAME_CANCEL_PASSWORD
			type					1
			font					5
			textscale				0.89
			style					WINDOW_STYLE_EMPTY
			rect					30 187.5 300 45
			textalign				ITEM_ALIGN_CENTER
			textalignx				150
			textaligny				10.5
			forecolor				0.86 0.90 0.945 1
			visible					1
			action
			{
				play "sound/interface/button1.wav"
				close password_request
			}
			mouseEnter
			{
				show button_glow
				setitemrect button_glow 10 128 240 26
			}
			mouseExit { hide button_glow }
			caps					1
		}
		canvas					1600 900
	}
}
