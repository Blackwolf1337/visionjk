// changelog.menu in the new look. Made by tools/menus/build.py from ui/jamp/changelog.menu: change that script or its
// rules, not this file. See docs/japlus/ui.md.
{
	menuDef
	{
		name					"changelog_popmenu"
		visible					0
		fullScreen				0
		rect					280 110 1040 680
		focusColor				0.36 0.78 0.96 1
		outOfBoundsClick
		popup
		onOpen
		{
			uiScript Changelog ;
			setfocus changelog_entry
		}
		onESC
		{
			play "sound/interface/esc.wav" ;
			close changelog_popmenu ;
		}
		skin					1
		disableColor			0.40 0.47 0.56 1
		openSlide				8

		itemDef
		{
			name					vision_veil
			rect					-280 -110 1600 900
			visible					1
			style					WINDOW_STYLE_FILLED
			backcolor				0 0 0 0.55
			decoration
			wide					1
		}

		itemDef
		{
			name					vision_dialog
			rect					0 0 1040 680
			visible					1
			style					WINDOW_STYLE_PANEL
			backcolor				0.039 0.071 0.133 0.96
			bordercolor				0.153 0.251 0.373 1
			radius					12
			decoration
			shadow					40
		}

		itemDef
		{
			name					changelog_title
			group					none
			style					WINDOW_STYLE_EMPTY
			text					@VISION_WHAT_S_NEW
			rect					28 24 984 34
			textalign				ITEM_ALIGN_LEFT
			textalignx				0
			font					5
			textscale				1.33
			forecolor				1 1 1 1
			visible					1
			decoration
			textaligny				5
		}

		itemDef
		{
			name					changelog_list
			group					none
			rect					28 70 260 518
			type					ITEM_TYPE_LISTBOX
			style					WINDOW_STYLE_PANEL
			elementwidth			140
			elementheight			18
			font					5
			textscale				0.52
			backcolor				0.027 0.051 0.102 1
			bordercolor				0.153 0.251 0.373 1
			forecolor				0.86 0.90 0.945 1
			elementtype				LISTBOX_TEXT
			feeder					FEEDER_CHANGELOG
			visible					1
			textaligny				14.9
			radius					6
			outlinecolor			0.36 0.78 0.96 0.22
		}

		itemDef
		{
			name					changelog_entry
			group					none
			rect					308 70 704 518
			type					ITEM_TYPE_OWNERDRAW
			ownerdraw				UI_CHANGELOG
			style					WINDOW_STYLE_PANEL
			backcolor				0.016 0.031 0.063 0.45
			bordercolor				0.086 0.149 0.247 1
			font					5
			textscale				0.89
			forecolor				0.86 0.90 0.945 1
			visible					1
			radius					5
		}

		itemDef
		{
			name					changelog_update
			group					none
			style					WINDOW_STYLE_PANEL
			type					ITEM_TYPE_BUTTON
			rect					600 608 180 44
			text					@VISION_UPDATE_NOW
			font					5
			textscale				0.83
			textalign				ITEM_ALIGN_CENTER
			textalignx				90
			forecolor				0.86 0.90 0.945 1
			cvarTest				"v_updateState"
			showCvar { "1" }
			visible					1
			action
			{
				play "sound/interface/button1.wav" ;
				exec "update" ;
				close changelog_popmenu ;
			}
			caps					1
			textaligny				14.5
			radius					6
			backcolor				0 0 0 0
			bordercolor				0.153 0.251 0.373 1
		}

		itemDef
		{
			name					changelog_done
			group					none
			style					WINDOW_STYLE_PANEL
			type					ITEM_TYPE_BUTTON
			rect					792 608 220 44
			text					@MENUS_DONE_CAPS
			font					7
			textscale				0.83
			textalign				ITEM_ALIGN_CENTER
			textalignx				110
			forecolor				0.016 0.071 0.122 1
			visible					1
			action
			{
				play "sound/interface/button1.wav" ;
				close changelog_popmenu ;
			}
			caps					1
			textaligny				14.5
			radius					6
			backcolor				0.36 0.78 0.96 1
			bordercolor				0.36 0.78 0.96 1
		}
		canvas					1600 900
		style					WINDOW_STYLE_EMPTY
		descX					800
		descY					804
		descAlignment			ITEM_ALIGN_CENTER
		descScale				0.78
		descColor				0.56 0.64 0.74 1
	}
}
