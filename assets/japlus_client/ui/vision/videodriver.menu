// videodriver.menu in the new look. Made by tools/menus/build.py from ui/jamp/videodriver.menu: change that script or its
// rules, not this file. See docs/japlus/ui.md.
{
	menuDef
	{
		name					"videodriverMenu"
		visible					0
		fullScreen				0
		rect					470 272 666 490.5
		focusColor				0.36 0.78 0.96 1
		outOfBoundsClick
		descX					803
		descY					770
		descScale				1.05
		descColor				0.56 0.64 0.74 1
		descAlignment			ITEM_ALIGN_CENTER
		popup
		onESC
		{
			play "sound/interface/button1.wav"
			close all
			open setupMenu
		}
		onClose { play "sound/interface/button1.wav" ; }
		skin					1
		disableColor			0.40 0.47 0.56 1
		openSlide				8
		style					WINDOW_STYLE_EMPTY

		itemDef
		{
			name					vision_veil
			rect					-150 -180 960 720
			visible					1
			style					WINDOW_STYLE_FILLED
			backcolor				0 0.01 0.03 0.6
			wide					1
			decoration
		}

		itemDef
		{
			name					driver_background
			group					none
			style					WINDOW_STYLE_PANEL
			rect					0 0 666 490.5
			forecolor				1 1 1 1
			visible					1
			decoration
			backcolor				0.031 0.055 0.11 0.97
			bordercolor				0.11 0.18 0.29 1
			radius					9.6
			shadow					21
		}

		itemDef
		{
			name					driver_done
			group					none
			text					@MENUS_DONE_CAPS
			type					ITEM_TYPE_BUTTON
			style					WINDOW_STYLE_PANEL
			rect					247.5 442.5 165 30
			textalign				ITEM_ALIGN_CENTER
			textstyle				0
			textalignx				82.5
			textaligny				6
			font					5
			textscale				0.96
			forecolor				0.86 0.90 0.945 1
			visible					1
			mouseEnter { show driver_done_button }
			mouseExit { hide driver_done_button }
			action { close videodriverMenu }
			caps					1
			radius					4.8
			backcolor				0 0 0 0
			bordercolor				0.153 0.251 0.373 1
		}

		itemDef
		{
			name					game_version
			group					none
			ownerdraw				UI_GLINFO
			font					5
			textscale				1.02
			rect					15 4.5 645 420
			forecolor				0.91 0.77 0.42 1
			style					WINDOW_STYLE_EMPTY
			textalign				ITEM_ALIGN_LEFT
			textaligny				22.5
			visible					1
			decoration
		}
		canvas					1600 900
	}
