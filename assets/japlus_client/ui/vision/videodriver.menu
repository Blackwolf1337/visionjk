// videodriver.menu in the new look. Made by tools/menus/build.py from ui/jamp/videodriver.menu: change that script or its
// rules, not this file. See docs/japlus/ui.md.
{
	menuDef
	{
		name					"videodriverMenu"
		visible					0
		fullScreen				0
		rect					100 120 444 327
		focusColor				0.43 0.83 1 1
		outOfBoundsClick
		descX					322
		descY					452
		descScale				0.7
		descColor				0.60 0.69 0.78 1
		descAlignment			ITEM_ALIGN_CENTER
		popup
		onESC
		{
			play "sound/interface/button1.wav"
			close all
			open setupMenu
		}
		onClose { play "sound/interface/button1.wav" ; }

		itemDef
		{
			name					vision_veil
			rect					-100 -120 640 480
			visible					1
			style					WINDOW_STYLE_FILLED
			backcolor				0 0.01 0.03 0.6
			wide					1
			decoration
		}

		itemDef
		{
			name					driver_background
			group					none
			style					WINDOW_STYLE_PANEL
			rect					0 0 444 327
			forecolor				1 1 1 1
			visible					1
			decoration
			backcolor				0.035 0.07 0.12 0.94
			bordercolor				0.43 0.83 1 0.28
			radius					8
			shadow					14
			sheen					0.08
		}

		itemDef
		{
			name					driver_done
			group					none
			text					@MENUS_DONE_CAPS
			type					ITEM_TYPE_BUTTON
			style					WINDOW_STYLE_PANEL
			rect					165 295 110 20
			textalign				ITEM_ALIGN_CENTER
			textstyle				0
			textalignx				55
			textaligny				4
			font					5
			textscale				0.64
			forecolor				0.86 0.92 0.97 1
			visible					1
			mouseEnter { show driver_done_button }
			mouseExit { hide driver_done_button }
			action { close videodriverMenu }
			caps					1
			radius					10
			backcolor				1 1 1 0.05
			bordercolor				0.43 0.83 1 0.16
		}

		itemDef
		{
			name					game_version
			group					none
			ownerdraw				UI_GLINFO
			font					5
			textscale				0.68
			rect					10 3 430 280
			forecolor				1 0.74 0.30 1
			style					WINDOW_STYLE_EMPTY
			textalign				ITEM_ALIGN_LEFT
			textaligny				15
			visible					1
			decoration
		}
		skin					1
		disableColor			0.36 0.42 0.50 1
		openSlide				8
		style					WINDOW_STYLE_EMPTY
	}
}
