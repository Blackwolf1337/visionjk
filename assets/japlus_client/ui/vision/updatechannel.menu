// updatechannel.menu in the new look. Made by tools/menus/build.py from ui/jamp/updatechannel.menu: change that script or its
// rules, not this file. See docs/japlus/ui.md.
{
	menuDef
	{
		name					"updateChannelMenu"
		visible					0
		fullScreen				0
		rect					0 0 640 480
		focusColor				0.43 0.83 1 1
		outOfBoundsClick
		descX					320
		descY					424
		descScale				1
		descColor				0.60 0.69 0.78 1
		descAlignment			ITEM_ALIGN_CENTER
		popup
		onOpen { setfocus updatechannel_no }
		onESC
		{
			play "sound/interface/button1.wav" ;
			close updateChannelMenu ;
		}

		itemDef
		{
			name					updatechannel_title
			group					none
			style					WINDOW_STYLE_EMPTY
			text					@MENUS_WARNING
			rect					100 166 440 20
			textalign				ITEM_ALIGN_CENTER
			textalignx				220
			font					5
			textscale				0.74
			forecolor				0.86 0.92 0.97 1
			visible					1
			decoration
			caps					1
			textaligny				2.5
		}

		itemDef
		{
			name					updatechannel_line1
			group					none
			style					WINDOW_STYLE_EMPTY
			text					@VISION_DEVELOPMENT_BUILDS_ARE_EARLY_TEST_VE
			rect					100 210 440 16
			textalign				ITEM_ALIGN_CENTER
			textalignx				220
			font					5
			textscale				0.6
			forecolor				0.86 0.92 0.97 1
			visible					1
			decoration
			textaligny				1.05
		}

		itemDef
		{
			name					updatechannel_line2
			group					none
			style					WINDOW_STYLE_EMPTY
			text					@VISION_THEY_CAN_CRASH_CORRUPT_YOUR_CONFIGS
			rect					100 228 440 16
			textalign				ITEM_ALIGN_CENTER
			textalignx				220
			font					5
			textscale				0.6
			forecolor				0.86 0.92 0.97 1
			visible					1
			decoration
			textaligny				1.05
		}

		itemDef
		{
			name					updatechannel_line3
			group					none
			style					WINDOW_STYLE_EMPTY
			text					@VISION_YOU_CAN_SWITCH_BACK_TO_STABLE_AT_ANY
			rect					100 246 440 16
			textalign				ITEM_ALIGN_CENTER
			textalignx				220
			font					5
			textscale				0.6
			forecolor				0.60 0.69 0.78 1
			visible					1
			decoration
			textaligny				1.05
		}

		itemDef
		{
			name					updatechannel_no
			group					none
			style					WINDOW_STYLE_EMPTY
			type					ITEM_TYPE_BUTTON
			rect					115 300 200 24
			text					@VISION_STAY_ON_STABLE
			descText				@VISION_KEEP_THE_RELEASES
			font					5
			textscale				0.55
			textalign				ITEM_ALIGN_CENTER
			textalignx				100
			forecolor				0.86 0.92 0.97 1
			visible					1
			mouseEnter { show updatechannel_no_glow }
			mouseExit { hide updatechannel_no_glow }
			action
			{
				play "sound/interface/button1.wav" ;
				close updateChannelMenu ;
			}
			caps					1
			textaligny				1.88
		}

		itemDef
		{
			name					updatechannel_yes
			group					none
			style					WINDOW_STYLE_EMPTY
			type					ITEM_TYPE_BUTTON
			rect					325 300 200 24
			text					@VISION_SWITCH_TO_DEVELOPMENT
			descText				@VISION_UPDATE_TO_THE_DEVELOPMENT_BUILDS_FRO
			font					5
			textscale				0.55
			textalign				ITEM_ALIGN_CENTER
			textalignx				100
			forecolor				0.86 0.92 0.97 1
			visible					1
			mouseEnter { show updatechannel_yes_glow }
			mouseExit { hide updatechannel_yes_glow }
			action
			{
				play "sound/interface/button1.wav" ;
				setcvar v_updateChannel dev ;
				close updateChannelMenu ;
			}
			caps					1
			textaligny				1.88
		}
		skin					1
		disableColor			0.36 0.42 0.50 1
		openSlide				8
	}
}
