				setitemcolor typebut_dual forecolor 0.60 0.69 0.78 1
				setitemcolor typebut_staff forecolor 0.60 0.69 0.78 1
				show sabstyle
				transition2 saber 0 "0" 430 430 20 10
			}
		}

