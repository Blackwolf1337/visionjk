		{
			hide highlights
			show typebut
			show typebut_single
			show typebut_dual
			show typebut_staff
			show hilttype
			show hiltbut
			show hiltbut1
			show hiltbut2
			show hiltbut_staves
			hide rgbcolormenu
			show rgbsetupbutton
		}
