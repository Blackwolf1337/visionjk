{
	menuDef
	{
		name					"ingame_saber"
		visible					0
		fullscreen				0
		outOfBoundsClick
		rect					105 40 430 425
		focusColor				0.43 0.83 1 1
		style					WINDOW_STYLE_PANEL
		descX					320
		descY					440
		descScale				1
		descColor				0.60 0.69 0.78 1
		descAlignment			ITEM_ALIGN_CENTER
		onOpen
		{
			hide highlights
			hide rgbcolormenu
			show rgbsetupbutton
			uiScript "getsabercvars"
			uiScript "saber_hilt"
			uiScript "saber_color"
			uiScript "saber2_hilt"
			uiScript "saber2_color"
			setitemcolor typebut_single forecolor 0.60 0.69 0.78 1
			setitemcolor typebut_dual forecolor 0.60 0.69 0.78 1
			setitemcolor typebut_staff forecolor 0.60 0.69 0.78 1
			uiScript getsaberhiltinfo
		}
		onClose
		{
			hide highlights
			show typebut
			show typebut_single
			show typebut_dual
			show typebut_staff
			show hilttype
			show hiltbut
			show hiltbut1
			show hiltbut2
			show hiltbut_staves
			hide rgbcolormenu
			show rgbsetupbutton
		}

		itemDef
		{
			name					background_pic
			group					none
			style					WINDOW_STYLE_PANEL
