// cvarclean.menu in the new look. Made by tools/menus/build.py from ui/jamp/cvarclean.menu: change that script or its
// rules, not this file. See docs/japlus/ui.md.
{
	menuDef
	{
		name					"cvarclean_popmenu"
		visible					0
		fullScreen				0
		rect					0 0 640 480
		focusColor				0.36 0.78 0.96 1
		outOfBoundsClick
		popup
		onOpen
		{
			uiScript CvarClean ;
			setfocus cvarclean_list
		}
		onESC
		{
			play "sound/interface/esc.wav" ;
			close cvarclean_popmenu ;
		}

		itemDef
		{
			name					vision_veil
			rect					0 0 640 480
			visible					1
			style					WINDOW_STYLE_FILLED
			backcolor				0 0.01 0.03 0.6
			wide					1
			decoration
		}

		itemDef
		{
			name					cvarclean_background
			group					none
			style					WINDOW_STYLE_PANEL
			rect					16 42 608 392
			forecolor				1 1 1 1
			visible					1
			decoration
			backcolor				0.031 0.055 0.11 0.97
			bordercolor				0.11 0.18 0.29 1
			radius					6.4
			shadow					14
		}

		itemDef
		{
			name					cvarclean_title
			group					none
			style					WINDOW_STYLE_EMPTY
			text					@VISION_CLEAN_UP_SETTINGS
			rect					20 52 600 20
			textalign				ITEM_ALIGN_CENTER
			textalignx				300
			font					5
			textscale				0.74
			forecolor				0.86 0.90 0.945 1
			visible					1
			decoration
			caps					1
			textaligny				2.5
		}

		itemDef
		{
			name					cvarclean_list
			group					none
			rect					36 82 568 270
			type					ITEM_TYPE_LISTBOX
			style					WINDOW_STYLE_PANEL
			elementwidth			568
			elementheight			18
			font					5
			textscale				0.52
			backcolor				0.027 0.051 0.102 0.9
			bordercolor				0.086 0.149 0.247 1
			forecolor				0.86 0.90 0.945 1
			elementtype				LISTBOX_TEXT
			feeder					FEEDER_CVARCLEAN
			columns					3 4 20 216 230 20 216 456 20 104
			visible					1
			textaligny				14.9
			radius					4
			outlinecolor			0.36 0.78 0.96 0.22
		}

		itemDef
		{
			name					cvarclean_none
			group					none
			style					WINDOW_STYLE_EMPTY
			text					@VISION_NOTHING_TO_CLEAN_UP
			rect					36 200 568 20
			textalign				ITEM_ALIGN_CENTER
			textalignx				284
			font					5
			textscale				0.6
			forecolor				0.86 0.90 0.945 1
			cvarTest				"ui_cvarCleanCount"
			showCvar { "0" }
			visible					1
			decoration
			textaligny				1.05
		}

		itemDef
		{
			name					cvarclean_about
			group					none
			style					WINDOW_STYLE_EMPTY
			text					@VISION_SETTINGS_NO_CODE_USED_FOR_A_MONTH_LE
			rect					36 360 568 30
			textalign				ITEM_ALIGN_CENTER
			textalignx				284
			font					5
			textscale				0.52
			forecolor				0.86 0.90 0.945 1
			visible					1
			decoration
			textaligny				0.9
		}

		itemDef
		{
			name					cvarclean_remove
			group					none
			style					WINDOW_STYLE_PANEL
			type					ITEM_TYPE_BUTTON
			rect					75 402 110 20
			text					@VISION_REMOVE
			font					5
			textscale				0.64
			textalign				ITEM_ALIGN_CENTER
			textalignx				55
			forecolor				0.86 0.90 0.945 1
			visible					1
			mouseEnter { show cvarclean_remove_glow }
			mouseExit { hide cvarclean_remove_glow }
			action
			{
				play "sound/interface/button1.wav" ;
				uiScript CvarCleanRemove ;
			}
			caps					1
			textaligny				4
			radius					3.2
			backcolor				0 0 0 0
			bordercolor				0.153 0.251 0.373 1
		}

		itemDef
		{
			name					cvarclean_removeall
			group					none
			style					WINDOW_STYLE_PANEL
			type					ITEM_TYPE_BUTTON
			rect					265 402 110 20
			text					@VISION_REMOVE_ALL
			font					5
			textscale				0.64
			textalign				ITEM_ALIGN_CENTER
			textalignx				55
			forecolor				0.86 0.90 0.945 1
			visible					1
			mouseEnter { show cvarclean_removeall_glow }
			mouseExit { hide cvarclean_removeall_glow }
			action
			{
				play "sound/interface/button1.wav" ;
				uiScript CvarCleanRemoveAll ;
			}
			caps					1
			textaligny				4
			radius					3.2
			backcolor				0 0 0 0
			bordercolor				0.153 0.251 0.373 1
		}

		itemDef
		{
			name					cvarclean_done
			group					none
			style					WINDOW_STYLE_PANEL
			type					ITEM_TYPE_BUTTON
			rect					455 402 110 20
			text					@MENUS_DONE_CAPS
			font					5
			textscale				0.64
			textalign				ITEM_ALIGN_CENTER
			textalignx				55
			forecolor				0.86 0.90 0.945 1
			visible					1
			mouseEnter { show cvarclean_done_glow }
			mouseExit { hide cvarclean_done_glow }
			action
			{
				play "sound/interface/button1.wav" ;
				close cvarclean_popmenu ;
			}
			caps					1
			textaligny				4
			radius					3.2
			backcolor				0 0 0 0
			bordercolor				0.153 0.251 0.373 1
		}
		skin					1
		disableColor			0.40 0.47 0.56 1
		openSlide				8
		style					WINDOW_STYLE_EMPTY
		descX					320
		descY					439
		descAlignment			ITEM_ALIGN_CENTER
		descScale				0.7
		descColor				0.56 0.64 0.74 1
	}
}
