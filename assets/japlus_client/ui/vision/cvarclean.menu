			}
			caps					1
			textaligny				4
			radius					10
			backcolor				1 1 1 0.05
			bordercolor				0.43 0.83 1 0.16
		}

		itemDef
		{
			name					cvarclean_done
			group					none
			style					WINDOW_STYLE_PANEL
			type					ITEM_TYPE_BUTTON
			rect					455 402 110 20
			text					@MENUS_DONE_CAPS
			font					5
			textscale				0.64
			textalign				ITEM_ALIGN_CENTER
			textalignx				55
			forecolor				0.86 0.92 0.97 1
			visible					1
			mouseEnter { show cvarclean_done_glow }
			mouseExit { hide cvarclean_done_glow }
			action
			{
				play "sound/interface/button1.wav" ;
				close cvarclean_popmenu ;
			}
			caps					1
			textaligny				4
			radius					10
			backcolor				1 1 1 0.05
			bordercolor				0.43 0.83 1 0.16
		}
		skin					1
		disableColor			0.36 0.42 0.50 1
		openSlide				8
		style					WINDOW_STYLE_EMPTY
		descX					320
		descY					439
		descAlignment			ITEM_ALIGN_CENTER
