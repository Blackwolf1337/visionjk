{
	menuDef
	{
		name					"ingame_setup"
		visible					0
		fullscreen				0
		outOfBoundsClick
		rect					45 35 576 356
		focusColor				0.43 0.83 1 1
		style					WINDOW_STYLE_EMPTY
		descX					338
		descY					396
		descScale				0.7
		descColor				0.60 0.69 0.78 1
		descAlignment			ITEM_ALIGN_CENTER
		onOpen
		{
			uiScript getvideosetup
			show setup_background
			show video
			hide applyChanges
			hide video2
			hide vidrestart
			hide sound
			hide voicechat
			hide botmode
			hide options
			hide mods
			hide defaults
			hide default_glow
			hide highlight12
			setitemcolor setup_submenu forecolor 0.86 0.92 0.97 1
			setitemcolor videomenubutton forecolor 0.43 0.83 1 1
		}
		onESC
		{
			play "sound/interface/button1"
			defer VideoSetup videowarningMenu
			hide highlights
			close ingame_setup
		}

