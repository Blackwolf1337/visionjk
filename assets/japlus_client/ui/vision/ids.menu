// ids.menu in the new look. Made by tools/menus/build.py from ui/jamp/ids.menu: change that script or its
// rules, not this file. See docs/japlus/ui.md.
{
	menuDef
	{
		name					"ids_popmenu"
		visible					0
		fullScreen				0
		rect					0 0 640 480
		focusColor				0.43 0.83 1 1
		outOfBoundsClick
		descX					320
		descY					424
		descScale				1
		descColor				0.60 0.69 0.78 1
		descAlignment			ITEM_ALIGN_CENTER
		popup
		onOpen
		{
			uiScript IDSLog ;
			setfocus ids_list
		}
		onESC
		{
			play "sound/interface/esc.wav" ;
			close ids_popmenu ;
		}

		itemDef
		{
			name					ids_title
			group					none
			style					WINDOW_STYLE_EMPTY
			text					@VISION_INTRUSIONS
			rect					30 74 580 20
			textalign				ITEM_ALIGN_CENTER
			textalignx				290
			font					5
			textscale				0.74
			forecolor				0.86 0.92 0.97 1
			visible					1
			decoration
			caps					1
			textaligny				2.5
		}

		itemDef
		{
			name					ids_list
			group					none
			rect					50 102 540 230
			type					ITEM_TYPE_LISTBOX
			style					WINDOW_STYLE_PANEL
			elementwidth			540
			elementheight			16
			font					5
			textscale				0.52
			backcolor				0 0 0 0.30
			bordercolor				0.43 0.83 1 0.16
			forecolor				0.86 0.92 0.97 1
			elementtype				LISTBOX_TEXT
			feeder					FEEDER_IDSLOG
			visible					1
			textaligny				13.9
			radius					4
			outlinecolor			0.43 0.83 1 0.22
		}

		itemDef
		{
			name					ids_hint
			group					none
			style					WINDOW_STYLE_EMPTY
			text					@VISION_ALL_OF_IT_IS_IN_IDS_LOG_IN_THE_GAME
			rect					30 338 580 16
			textalign				ITEM_ALIGN_CENTER
			textalignx				290
			font					5
			textscale				0.6
			forecolor				0.60 0.69 0.78 1
			visible					1
			decoration
			textaligny				1.05
		}

		itemDef
		{
			name					ids_done
			group					none
			style					WINDOW_STYLE_EMPTY
			type					ITEM_TYPE_BUTTON
			rect					220 364 200 24
			text					@MENUS_DONE_CAPS
			font					5
			textscale				0.55
			textalign				ITEM_ALIGN_CENTER
			textalignx				100
			forecolor				0.86 0.92 0.97 1
			visible					1
			mouseEnter { show ids_done_glow }
			mouseExit { hide ids_done_glow }
			action
			{
				play "sound/interface/button1.wav" ;
				close ids_popmenu ;
			}
			caps					1
			textaligny				1.88
		}
		skin					1
		disableColor			0.36 0.42 0.50 1
		openSlide				8
	}
}
