// serverinfo.menu in the new look. Made by tools/menus/build.py from ui/jamp/serverinfo.menu: change that script or its
// rules, not this file. See docs/japlus/ui.md.
{
	menuDef
	{
		name					"serverinfo_popmenu"
		visible					0
		fullscreen				0
		outOfBoundsClick
		rect					530 182 540 540
		focusColor				0.36 0.78 0.96 1
		style					WINDOW_STYLE_EMPTY
		descX					800
		descY					714.5
		descScale				1.05
		descColor				0.56 0.64 0.74 1
		descAlignment			ITEM_ALIGN_CENTER
		popup
		onOpen { uiScript ServerStatus }
		onESC
		{
			play "sound/interface/esc.wav" ;
			close serverinfo_popmenu
		}
		skin					1
		disableColor			0.40 0.47 0.56 1
		openSlide				8

		itemDef
		{
			name					vision_veil
			rect					-210 -90 960 720
			visible					1
			style					WINDOW_STYLE_FILLED
			backcolor				0 0.01 0.03 0.6
			wide					1
			decoration
		}

		itemDef
		{
			name					setup_background
			group					none
			style					WINDOW_STYLE_PANEL
			rect					0 0 540 525
			backcolor				0.031 0.055 0.11 0.97
			forecolor				1 1 1 1
			bordercolor				0.11 0.18 0.29 1
			visible					1
			decoration
			radius					9.6
			shadow					21
		}

		itemDef
		{
			name					screenTitle
			text					@MENUS_SERVER_INFORMATION
			style					WINDOW_STYLE_EMPTY
			rect					15 7.5 510 30
			font					5
			textscale				0.78
			textalign				ITEM_ALIGN_CENTER
			textalignx				255
			textaligny				4.12
			forecolor				0.56 0.64 0.74 1
			visible					1
			decoration
			caps					1
		}

		itemDef
		{
			name					serverinfoList
			rect					15 40.5 510 420
			type					ITEM_TYPE_LISTBOX
			style					WINDOW_STYLE_PANEL
			feeder					FEEDER_SERVERSTATUS
			elementtype				LISTBOX_TEXT
			elementwidth			180
			elementheight			24
			font					5
			textscale				1.02
			backcolor				0.027 0.051 0.102 0.9
			bordercolor				0.086 0.149 0.247 1
			notselectable
			visible					1
			columns					4 3 40 222 75 40 75 150 40 67.5 225 40 247.5
			radius					6
			outlinecolor			0.36 0.78 0.96 0.22
		}

		itemDef
		{
			name					refresh
			text					@MENUS_REFRESH_LIST
			descText				@MENUS_REFRESH_SERVER_LIST
			type					1
			font					5
			textscale				0.96
			style					WINDOW_STYLE_PANEL
			rect					60 472.5 165 30
			textalign				ITEM_ALIGN_CENTER
			textalignx				82.5
			textaligny				6
			forecolor				0.86 0.90 0.945 1
			visible					1
			action
			{
				play "sound/interface/button1.wav"
				uiScript ServerStatus
			}
			mouseEnter
			{
				show button_glow
				setitemrect button_glow 0 310 200 28
			}
			mouseExit { hide button_glow }
			caps					1
			radius					4.8
			backcolor				0 0 0 0
			bordercolor				0.153 0.251 0.373 1
		}

		itemDef
		{
			name					doneText
			text					@MENUS_DONE_CAPS
			descText				@MENUS_DONE_DESC
			type					1
			font					5
			textscale				0.96
			style					WINDOW_STYLE_PANEL
			rect					315 472.5 165 30
			textalign				ITEM_ALIGN_CENTER
			textalignx				82.5
			textaligny				6
			forecolor				0.86 0.90 0.945 1
			visible					1
			action
			{
				play "sound/interface/button1.wav"
				close serverinfo_popmenu
			}
			mouseEnter
			{
				show button_glow
				setitemrect button_glow 170 310 200 28
			}
			mouseExit { hide button_glow }
			caps					1
			radius					4.8
			backcolor				0 0 0 0
			bordercolor				0.153 0.251 0.373 1
		}
		canvas					1600 900
	}
}
