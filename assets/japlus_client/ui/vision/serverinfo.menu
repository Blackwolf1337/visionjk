// serverinfo.menu in the new look. Made by tools/menus/build.py from ui/jamp/serverinfo.menu: change that script or its
// rules, not this file. See docs/japlus/ui.md.
{
	menuDef
	{
		name					"serverinfo_popmenu"
		visible					0
		fullscreen				0
		outOfBoundsClick
		rect					140 60 360 360
		focusColor				0.43 0.83 1 1
		style					WINDOW_STYLE_EMPTY
		descX					320
		descY					415
		descScale				0.7
		descColor				0.60 0.69 0.78 1
		descAlignment			ITEM_ALIGN_CENTER
		popup
		onOpen { uiScript ServerStatus }
		onESC
		{
			play "sound/interface/esc.wav" ;
			close serverinfo_popmenu
		}

		itemDef
		{
			name					vision_veil
			rect					-1140 -60 2640 480
			visible					1
			style					WINDOW_STYLE_FILLED
			backcolor				0 0.01 0.03 0.6
			decoration
		}

		itemDef
		{
			name					setup_background
			group					none
			style					WINDOW_STYLE_PANEL
			rect					0 0 360 350
			backcolor				0.035 0.07 0.12 0.94
			forecolor				1 1 1 1
			bordercolor				0.43 0.83 1 0.28
			visible					1
			decoration
			radius					8
			shadow					14
			sheen					0.08
		}

		itemDef
		{
			name					screenTitle
			text					@MENUS_SERVER_INFORMATION
			style					WINDOW_STYLE_EMPTY
			rect					10 5 340 20
			font					5
			textscale				0.52
			textalign				ITEM_ALIGN_CENTER
			textalignx				170
			textaligny				2.75
			forecolor				0.60 0.69 0.78 1
			visible					1
			decoration
			caps					1
		}

		itemDef
		{
			name					serverinfoList
			rect					10 27 340 280
			type					ITEM_TYPE_LISTBOX
			style					WINDOW_STYLE_PANEL
			feeder					FEEDER_SERVERSTATUS
			elementtype				LISTBOX_TEXT
			elementwidth			120
			elementheight			16
			font					5
			textscale				0.68
			backcolor				0 0 0 0.30
			bordercolor				0.43 0.83 1 0.16
			notselectable
			visible					1
			columns					4 2 40 148 50 40 50 100 40 45 150 40 165
			radius					4
			outlinecolor			0.43 0.83 1 0.22
		}

		itemDef
		{
			name					refresh
			text					@MENUS_REFRESH_LIST
			descText				@MENUS_REFRESH_SERVER_LIST
			type					1
			font					5
			textscale				0.64
			style					WINDOW_STYLE_PANEL
			rect					40 315 110 20
			textalign				ITEM_ALIGN_CENTER
			textalignx				55
			textaligny				4
			forecolor				0.86 0.92 0.97 1
			visible					1
			action
			{
				play "sound/interface/button1.wav"
				uiScript ServerStatus
			}
			mouseEnter
			{
				show button_glow
				setitemrect button_glow 0 310 200 28
			}
			mouseExit { hide button_glow }
			caps					1
			radius					10
			backcolor				1 1 1 0.05
			bordercolor				0.43 0.83 1 0.16
		}

		itemDef
		{
			name					doneText
			text					@MENUS_DONE_CAPS
			descText				@MENUS_DONE_DESC
			type					1
			font					5
			textscale				0.64
			style					WINDOW_STYLE_PANEL
			rect					210 315 110 20
			textalign				ITEM_ALIGN_CENTER
			textalignx				55
			textaligny				4
			forecolor				0.86 0.92 0.97 1
			visible					1
			action
			{
				play "sound/interface/button1.wav"
				close serverinfo_popmenu
			}
			mouseEnter
			{
				show button_glow
				setitemrect button_glow 170 310 200 28
			}
			mouseExit { hide button_glow }
			caps					1
			radius					10
			backcolor				1 1 1 0.05
			bordercolor				0.43 0.83 1 0.16
		}
		skin					1
		disableColor			0.36 0.42 0.50 1
		openSlide				8
	}
}
