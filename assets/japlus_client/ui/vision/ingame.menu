			style					WINDOW_STYLE_EMPTY
			font					5
			textscale				0.58
			textstyle				0
			textalign				ITEM_ALIGN_CENTER
			textalignx				28.64
			textaligny				7
			forecolor				0.86 0.92 0.97 1
			backcolor				0 0 0 0
			visible					1
			cvartest				"g_gametype"
			showcvar { "0" , "1" , "2" , "3" , "4" , "5" , "6" , "8" }
			action
			{
				play "sound/interface/button1.wav" ;
				open ingame_join
			}
			mouseenter { show joinButton }
			mouseexit { hide joinButton }
			caps					1
		}

