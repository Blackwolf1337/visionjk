// ingame.menu in the new look. Made by tools/menus/build.py from ui/jamp/ingame.menu: change that script or its
// rules, not this file. See docs/japlus/ui.md.
{
	assetGlobalDef
	{
		font					"ergoec" 18
		smallFont				"ocr_a" 18
		bigFont					"anewhope" 20
		small2Font				"arialnb" 14
		cursor					"cursor"
		gradientBar				"ui/assets/gradientbar2.tga"
		itemFocusSound			"sound/interface/menuroam.wav"
		fadeClamp				1.0
		fadeCycle				1
		fadeAmount				0.1
		shadowColor				0.1 0.1 0.1 0.25
		precacheSound
		{
			"sound/interface/choose_color.wav" ;
			"sound/interface/choose_head.wav" ;
			"sound/interface/choose_torso.wav" ;
			"sound/interface/choose_saber.wav" ;
			"sound/interface/choose_hilt.wav" ;
			"sound/interface/choose_blade.wav" ;
			"sound/interface/transition.wav" ;
			"sound/interface/esc.wav" ;
			"sound/interface/sub_select.wav" ;
		}
		focuscolor				0.36 0.78 0.96 1
	}

	menuDef
	{
		name					"ingame"
		visible					0
		fullScreen				0
		outOfBoundsClick
		rect					160 0 1280 960
		focusColor				0.36 0.78 0.96 1
		disableColor			0.40 0.47 0.56 1
		onOpen { uiScript setBotButton }
		skin					1
		openSlide				8

		itemDef
		{
			name					vision_bar
			rect					0 0 1280 52
			visible					1
			style					WINDOW_STYLE_FILLED
			backcolor				0.016 0.031 0.063 0.8
			wide					1
			decoration
		}

		itemDef
		{
			name					vision_bar_line
			rect					0 52 1280 1.34
			visible					1
			style					WINDOW_STYLE_FILLED
			backcolor				0.086 0.149 0.247 1
			wide					1
			decoration
		}

		itemDef
		{
			name					join
			text					@MENUS_JOIN
			cvarTest				"ui_singleplayeractive"
			disableCvar { "1" }
			rect					16 0 104 52
			type					ITEM_TYPE_BUTTON
			style					WINDOW_STYLE_EMPTY
			font					5
			textscale				1.12
			textstyle				0
			textalign				ITEM_ALIGN_CENTER
			textalignx				52
			textaligny				15.92
			forecolor				0.86 0.90 0.945 1
			backcolor				0 0 0 0
			visible					1
			cvartest				"g_gametype"
			showcvar { "0" , "1" , "2" , "3" , "4" , "5" , "6" , "8" }
			action
			{
				play "sound/interface/button1.wav" ;
				open ingame_join
			}
			mouseenter { show joinButton }
			mouseexit { hide joinButton }
			caps					1
			flow					1
		}

