// demo.menu in the new look. Made by tools/menus/build.py from ui/jamp/demo.menu: change that script or its
// rules, not this file. See docs/japlus/ui.md.
{
	menuDef
	{
		name					"demo"
		fullScreen				MENU_TRUE
		rect					0 0 640 480
		visible					MENU_TRUE
		focusColor				0.36 0.78 0.96 1
		descX					40
		descY					80
		descScale				0.8
		descColor				0.56 0.64 0.74 1
		descAlignment			ITEM_ALIGN_LEFT
		onOpen { uiScript LoadDemos ; }
