// error.menu in the new look. Made by tools/menus/build.py from ui/jamp/error.menu: change that script or its
// rules, not this file. See docs/japlus/ui.md.
{
	menuDef
	{
		name					"error_popmenu"
		visible					0
		fullscreen				0
		rect					520 290 560 320
		focusColor				0.36 0.78 0.96 1
		style					WINDOW_STYLE_EMPTY
		popup
		outOfBoundsClick
		onClose { uiScript clearError }
		onOpen {  }
		onESC
		{
			close error_popmenu ;
			open main
		}
		skin					1
		disableColor			0.40 0.47 0.56 1
		openSlide				8
		backcolor				0.031 0.055 0.11 0.86
		bordercolor				0.11 0.18 0.29 1
		radius					6.4
		shadow					14

		itemDef
		{
			name					vision_veil
			rect					-520 -290 1600 900
			visible					1
			style					WINDOW_STYLE_FILLED
			backcolor				0 0 0 0.55
			decoration
			wide					1
		}

		itemDef
		{
			name					vision_dialog
			rect					0 0 560 320
			visible					1
			style					WINDOW_STYLE_PANEL
			backcolor				0.039 0.071 0.133 0.96
			bordercolor				0.153 0.251 0.373 1
			radius					12
			decoration
			shadow					40
		}

		itemDef
		{
			name					errorinfo
			rect					28 23.2 504 18
			text					@MENUS_ERROR
			textalign				ITEM_ALIGN_LEFT
			textstyle				0
			textscale				0.67
			textalignx				0
			forecolor				0.56 0.64 0.74 1
			visible					1
			decoration
			font					7
			textaligny				3
			caps					1
		}

		itemDef
		{
			name					errorinfo
			rect					28 49.2 504 180
			type					ITEM_TYPE_TEXT
			style					WINDOW_STYLE_EMPTY
			textstyle				0
			autowrapped
			cvar					"com_errorMessage"
			textalign				ITEM_ALIGN_LEFT
			textalignx				0
			textscale				0.94
			forecolor				1 1 1 1
			visible					1
			decoration
			font					5
			textaligny				0
		}

		itemDef
		{
			name					exit
			group					grpControlbutton
			style					WINDOW_STYLE_PANEL
			type					ITEM_TYPE_BUTTON
			rect					312 248 220 44
			text					@MENUS_OKAY
			textscale				0.83
			textalign				ITEM_ALIGN_CENTER
			textalignx				110
			forecolor				0.016 0.071 0.122 1
			visible					1
			action
			{
				play "sound/misc/nomenu.wav"
				close error_popmenu
				open main
			}
			font					7
			textaligny				14.5
			radius					6
			backcolor				0.36 0.78 0.96 1
			bordercolor				0.36 0.78 0.96 1
			caps					1
		}
		canvas					1600 900
		descX					800
		descY					624
		descAlignment			ITEM_ALIGN_CENTER
		descScale				0.78
		descColor				0.56 0.64 0.74 1
	}
}
