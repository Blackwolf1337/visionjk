{
	menuDef
	{
		name					"ingame_objectives"
		fullScreen				0
		visible					0
		outOfBoundsClick
		rect					160 0 654 1114
		focusColor				0.36 0.78 0.96 1
		style					WINDOW_STYLE_EMPTY
		descX					487
		descY					-30
		descScale				1.4
		descColor				0.56 0.64 0.74 1
		descAlignment			ITEM_ALIGN_CENTER
		disablecolor			0.40 0.47 0.56 1
		onClose
		{
			hide minidesc
			hide obj_longdesc
			hide objective_pic
		}
		onOpen
		{
			setcvar currentObjButton "null"
			exec "siegeCompleteCvarUpdate"
			setitembackground mappic "*siege_mapgraphic"
			uiscript updatesiegeobjgraphics
			setitembackground team1_symbol "*team1_icon"
			setitembackground team2_symbol "*team2_icon"
			setitembackground team1_button "*team1_icon"
			setitembackground team2_button "*team2_icon"
			disable team_button 0
			disable autoteam 0
			disable team1_button 0
			disable team2_button 0
			setitemcolor team1_button backcolor .8 .48 0 1
			setitemcolor team2_button backcolor .8 .48 0 1
			setitemcolor team1name forecolor 0.86 0.90 0.945 1
			setitemcolor team2name forecolor 0.86 0.90 0.945 1
			setitemcolor team1_count forecolor 0.86 0.90 0.945 1
			setitemcolor team2_count forecolor 0.86 0.90 0.945 1
			setitemcolor siegeclassconfigtitle forecolor 0.86 0.90 0.945 1
			setitemcolor team1obj_buttons bordercolor 0.086 0.149 0.247 1
			setitemcolor team2obj_buttons bordercolor 0.086 0.149 0.247 1
			setitemcolor team1obj_buttons forecolor 0.36 0.78 0.96 1
			setitemcolor team2obj_buttons forecolor 0.36 0.78 0.96 1
			disable team1obj_buttons 0
			disable team2obj_buttons 0
			hide grey_button
			hide class_portrait
			show obj_minidesc
			show obj_longdesc
			show objective_pic
			setitemtext obj_minidesc @MENUS_OBJECTIVE_1
			setitemtext obj_longdesc "*team1_objective1_longdesc"
			setitembackground objective_pic "*team1_objective1_gfx"
			setitembackground tm1_icon1 "*team1_objective1_mapicon"
			setitemcolor team1obj_buttons forecolor 0.86 0.90 0.945 1
			setitemcolor team1obj_buttons backcolor .7 0 0 1
			setitemcolor team2obj_buttons forecolor 0.86 0.90 0.945 1
			setitemcolor team2obj_buttons backcolor 0 0 .7 1
			setitemcolor mapicons bordercolor 0.086 0.149 0.247 1
			setitemcolor team1obj1_button bordercolor 0.36 0.78 0.96 0.6
			setitemcolor team1obj1_button backcolor 1 0 0 1
			uiscript setsiegeobjbuttons tm1_icon1 team1_objective1_mapicon team1_objective1_litmapicon
		}
		onESC
		{
			hide minidesc
			hide fulldesc
			hide objective_pic
			close all;
		}
		skin					1
		openSlide				8

