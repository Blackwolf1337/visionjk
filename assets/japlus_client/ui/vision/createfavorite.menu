// createfavorite.menu in the new look. Made by tools/menus/build.py from ui/jamp/createfavorite.menu: change that script or its
// rules, not this file. See docs/japlus/ui.md.
{
	menuDef
	{
		name					"createfavorite_popmenu"
		visible					0
		fullscreen				0
		outOfBoundsClick
		rect					620 317 360 270
		focusColor				0.36 0.78 0.96 1
		style					WINDOW_STYLE_EMPTY
		descX					800
		descY					549.5
		descScale				1.05
		descColor				0.56 0.64 0.74 1
		descAlignment			ITEM_ALIGN_CENTER
		popup
		onOpen { setfocus addressEntry }
		onESC
		{
			play "sound/interface/esc.wav" ;
			close createfavorite_popmenu
		}
		skin					1
		disableColor			0.40 0.47 0.56 1
		openSlide				8

		itemDef
		{
			name					vision_veil
			rect					-300 -225 960 720
			visible					1
			style					WINDOW_STYLE_FILLED
			backcolor				0 0.01 0.03 0.6
			wide					1
			decoration
		}

		itemDef
		{
			name					setup_background
			group					none
			style					WINDOW_STYLE_PANEL
			rect					0 0 360 225
			backcolor				0.031 0.055 0.11 0.97
			forecolor				1 1 1 1
			bordercolor				0.11 0.18 0.29 1
			visible					1
			decoration
			radius					9.6
			shadow					21
		}

		itemDef
		{
			name					title
			text					@MENUS_FAVORITE_SERVER_INFO
			style					WINDOW_STYLE_EMPTY
			rect					7.5 7.5 330 30
			font					5
			textscale				0.78
			textalign				ITEM_ALIGN_CENTER
			textalignx				165
			textaligny				4.12
			forecolor				0.56 0.64 0.74 1
			visible					1
			decoration
			caps					1
		}

		itemDef
		{
			name					addressTitle
			text					@MENUS_ENTER_IP_ADDRESS
			style					0
			decoration
			font					5
			textscale				1.03
			rect					15 52.5 330 30
			textalign				ITEM_ALIGN_CENTER
			textalignx				165
			textaligny				6.3
			forecolor				0.56 0.64 0.74 1
			visible					1
		}

		itemDef
		{
			name					addressEntry
			style					WINDOW_STYLE_PANEL
			maxPaintChars			21
			text					" "
			descText				@MENUS_INPUT_IP_ADDRESS_OF_SERVER
			font					5
			textscale				1.03
			TYPE					4
			maxchars				21
			cvar					"ui_favoriteAddress"
			rect					15 88.5 330 30
			textalign				ITEM_ALIGN_LEFT
			textalignx				63
			textaligny				-1.2
			forecolor				0.56 0.64 0.74 1
			bordercolor				0.086 0.149 0.247 1
			backcolor				0.11 0.18 0.29 0.45
			visible					1
			mouseenter { setitemcolor addressEntry backcolor .25 .25 .25 .75 }
			mouseexit { setitemcolor addressEntry backcolor .25 .25 .25 .5 }
			radius					4.5
		}

		itemDef
		{
			name					doneText
			text					@MENUS_DONE
			descText				@MENUS_FINISHED_INPUTTING_INFO
			type					1
			font					5
			textscale				0.96
			style					WINDOW_STYLE_PANEL
			rect					97.5 172.5 165 30
			textalign				ITEM_ALIGN_CENTER
			textalignx				82.5
			textaligny				6
			forecolor				0.86 0.90 0.945 1
			visible					1
			action
			{
				play "sound/interface/button1.wav"
				uiScript CreateFavorite
				close createfavorite_popmenu
			}
			mouseEnter
			{
				show button_glow
				setitemrect button_glow 10 113 240 26
			}
			mouseExit { hide button_glow }
			caps					1
			radius					4.8
			backcolor				0 0 0 0
			bordercolor				0.153 0.251 0.373 1
		}
		canvas					1600 900
	}
