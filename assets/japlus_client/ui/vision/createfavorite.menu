			name					vision_veil
			rect					-540 -310 1600 900
			visible					1
			style					WINDOW_STYLE_FILLED
			backcolor				0 0 0 0.55
			decoration
			wide					1
		}

		itemDef
		{
			name					vision_dialog
			rect					0 0 520 280
			visible					1
			style					WINDOW_STYLE_PANEL
			backcolor				0.039 0.071 0.133 0.96
			bordercolor				0.153 0.251 0.373 1
			radius					12
			decoration
			shadow					40
		}

		itemDef
		{
			name					title
			text					@MENUS_FAVORITE_SERVER_INFO
