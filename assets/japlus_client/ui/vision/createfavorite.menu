			textalignx				0
			textaligny				5
			forecolor				1 1 1 1
			visible					1
			decoration
		}

		itemDef
		{
			name					addressTitle
			text					@MENUS_ENTER_IP_ADDRESS
			style					0
			decoration
			font					5
			textscale				0.83
			rect					28 70 464 23
			textalign				ITEM_ALIGN_LEFT
			textalignx				0
			textaligny				4
			forecolor				0.56 0.64 0.74 1
			visible					1
		}

		itemDef
		{
			name					addressEntry
			style					WINDOW_STYLE_EMPTY
			maxPaintChars			21
			text					""
			descText				@MENUS_INPUT_IP_ADDRESS_OF_SERVER
			font					5
			textscale				0.89
			TYPE					4
			maxchars				21
