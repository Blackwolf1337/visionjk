{
	menuDef
	{
		name					"saberMenu"
		fullScreen				1
		rect					0 0 640 480
		visible					1
		focusColor				0.36 0.78 0.96 1
		descX					320
		descY					458
		descScale				0.55
		descColor				0.56 0.64 0.74 1
		descAlignment			ITEM_ALIGN_CENTER
		onOpen
		{
			setcvar ui_saber "single_1"
			setcvar ui_saber_type "single"
			setcvar ui_saber2 "none"
			uiScript "saber_type"
			uiScript "getsabercvars"
