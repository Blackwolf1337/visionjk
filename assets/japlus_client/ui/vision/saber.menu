// saber.menu in the new look. Made by tools/menus/build.py from ui/jamp/saber.menu: change that script or its
// rules, not this file. See docs/japlus/ui.md.
{
	menuDef
	{
		name					"saberMenu"
		fullScreen				1
		rect					0 0 640 480
		visible					1
		focusColor				0.43 0.83 1 1
		descX					40
		descY					80
		descScale				0.8
		descColor				0.60 0.69 0.78 1
		descAlignment			ITEM_ALIGN_LEFT
		onOpen
		{
			setcvar ui_saber "single_1"
			setcvar ui_saber_type "single"
			setcvar ui_saber2 "none"
			uiScript "saber_type"
			uiScript "getsabercvars"
			uiScript "saber_hilt"
			uiScript "saber_color"
			uiScript "saber2_hilt"
			uiScript "saber2_color"
			uiScript setsaberboxesandhilts
			setitemcolor typebut_single forecolor 0.43 0.83 1 1
			setitemcolor typebut_dual forecolor 0.60 0.69 0.78 1
			setitemcolor typebut_staff forecolor 0.60 0.69 0.78 1
			uiScript getsaberhiltinfo
			show typebut
			show typebut_single
			show typebut_dual
			show typebut_staff
			show hilttype
			show hiltbut
			show hiltbut1
			show hiltbut2
			show hiltbut_staves
			show sabstyle
			show sabericons
			show sabericons2
			show box1
			show box3top
			show box3middle
			show box3bottom
			hide rgbcolormenu
			transition2 box3middle 418 126 219 0 20 5
			transition2 box3bottom 418 126 219 60 20 5
			transition2 saber 12 "-80" 615 615 20 10
		}
		onESC
		{
			play "sound/interface/menuroam.wav"
			uiScript "updatesabercvars"
			close saberMenu
			open characterMenu
		}

