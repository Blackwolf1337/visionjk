		onOpen
		{
			uiScript update "ui_GetName" uiScript getcharcvars ; setcvar ui_saber "single_1"
			setcvar ui_saber_type "single"
			setcvar ui_saber2 "none"
			uiScript "saber_type"
			uiScript "getsabercvars"
			uiScript "saber_hilt"
			uiScript "saber_color"
			uiScript "saber2_hilt"
			uiScript "saber2_color"
			uiScript setsaberboxesandhilts
			setitemcolor typebut_single forecolor 0.36 0.78 0.96 1
			setitemcolor typebut_dual forecolor 0.56 0.64 0.74 1
			setitemcolor typebut_staff forecolor 0.56 0.64 0.74 1
			uiScript getsaberhiltinfo
		}
		onClose { uiScript update "ui_SetName" uiScript updatesabercvars ; }
		canvas					1600 900
	}
}
