// vid_warning.menu in the new look. Made by tools/menus/build.py from ui/jamp/vid_warning.menu: change that script or its
// rules, not this file. See docs/japlus/ui.md.
{
	menuDef
	{
		name					"videowarningMenu"
		visible					0
		fullScreen				0
		rect					0 0 640 480
		focusColor				0.43 0.83 1 1
		outOfBoundsClick
		descX					320
		descY					425
		descScale				0.7
		descColor				0.60 0.69 0.78 1
		descAlignment			ITEM_ALIGN_CENTER
		popup
		onESC
		{
			play "sound/interface/button1.wav" ;
			close "videowarningMenu" ;
			setcvar "ui_r_modified" 0 ;
			rundeferred ;
		}
		onClose { play "sound/interface/button1.wav" ; }

		itemDef
		{
			name					vision_veil
			rect					-1000 0 2640 480
			visible					1
			style					WINDOW_STYLE_FILLED
			backcolor				0 0.01 0.03 0.6
			decoration
		}

		itemDef
		{
			name					warn_background
			group					none
			style					WINDOW_STYLE_PANEL
			rect					110 119 420 301
			forecolor				1 1 1 1
			visible					1
			decoration
			backcolor				0.035 0.07 0.12 0.94
			bordercolor				0.43 0.83 1 0.28
			radius					8
			shadow					14
			sheen					0.08
		}

		itemDef
		{
			name					vidwarn_title
			group					vidwarn
			style					WINDOW_STYLE_EMPTY
			text					@MENUS_UNAPPLIED_VIDEO_CHANGES
			rect					120 129 400 20
			font					5
			textscale				0.74
			textalign				ITEM_ALIGN_CENTER
			textalignx				200
			textaligny				-0.5
			forecolor				0.86 0.92 0.97 1
			visible					1
			decoration
			caps					1
		}

		itemDef
		{
			name					vidwarn_text1
			group					vidwarn
			text					@MENUS_YOU_HAVE_MADE_CHANGES
			rect					210 230 220 20
			textalign				ITEM_ALIGN_CENTER
			text2aligny				18
			textalignx				110
			font					5
			textscale				0.86
			forecolor				1 0.74 0.30 1
			visible					1
			decoration
			textaligny				1.5
		}

		itemDef
		{
			name					vidwarn_text2
			group					vidwarn
			text					@MENUS_APPLY_THESE_CHANGES_OR
			rect					210 250 220 20
			textalign				ITEM_ALIGN_CENTER
			textalignx				110
			font					5
			textscale				0.86
			forecolor				1 0.74 0.30 1
			visible					1
			textaligny				1.5
		}

		itemDef
		{
			name					vidwarn_no
			group					vidwarn
			text					@MENUS_DISCARD
			type					ITEM_TYPE_BUTTON
			style					WINDOW_STYLE_PANEL
			rect					185 388 110 20
			font					5
			textscale				0.64
			textalign				ITEM_ALIGN_CENTER
			textalignx				55
			textaligny				4
			descText				@MENUS_DO_NOT_APPLY_CHANGES
			forecolor				0.86 0.92 0.97 1
			visible					1
			action
			{
				play "sound/interface/button1.wav" ;
				close "videowarningMenu" ;
				setcvar "ui_r_modified" 0 ;
				rundeferred ;
			}
			mouseEnter { show vidwarn_no_button }
			mouseExit { hide vidwarn_no_button }
			caps					1
			radius					10
			backcolor				1 1 1 0.05
			bordercolor				0.43 0.83 1 0.16
		}

		itemDef
		{
			name					vidwarn_yes
			group					vidwarn
			text					@MENUS_APPLY
			type					ITEM_TYPE_BUTTON
			style					WINDOW_STYLE_PANEL
			rect					345 388 110 20
			font					5
			textscale				0.64
			textalign				ITEM_ALIGN_CENTER
			textalignx				55
			textaligny				4
			descText				@MENUS_APPLY_CHANGES_AND_THEN
			forecolor				1 1 1 1
			visible					1
			action
			{
				play "sound/interface/button1.wav" ;
				uiScript updatevideosetup ;
				close all
			}
			mouseEnter { show vidwarn_yes_button }
			mouseExit { hide vidwarn_yes_button }
			caps					1
			radius					10
			backcolor				0.43 0.83 1 0.20
			bordercolor				0.43 0.83 1 0.75
		}
		skin					1
		disableColor			0.36 0.42 0.50 1
		openSlide				8
		style					WINDOW_STYLE_EMPTY
	}
}
