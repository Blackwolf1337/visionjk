// vid_warning.menu in the new look. Made by tools/menus/build.py from ui/jamp/vid_warning.menu: change that script or its
// rules, not this file. See docs/japlus/ui.md.
{
	menuDef
	{
		name					"videowarningMenu"
		visible					0
		fullScreen				0
		rect					320 92 960 720
		focusColor				0.36 0.78 0.96 1
		outOfBoundsClick
		descX					800
		descY					729.5
		descScale				1.05
		descColor				0.56 0.64 0.74 1
		descAlignment			ITEM_ALIGN_CENTER
		popup
		onESC
		{
			play "sound/interface/button1.wav" ;
			close "videowarningMenu" ;
			setcvar "ui_r_modified" 0 ;
			rundeferred ;
		}
		onClose { play "sound/interface/button1.wav" ; }
		skin					1
		disableColor			0.40 0.47 0.56 1
		openSlide				8
		style					WINDOW_STYLE_EMPTY

		itemDef
		{
			name					vision_veil
			rect					0 0 960 720
			visible					1
			style					WINDOW_STYLE_FILLED
			backcolor				0 0.01 0.03 0.6
			wide					1
			decoration
		}

		itemDef
		{
			name					warn_background
			group					none
			style					WINDOW_STYLE_PANEL
			rect					165 178.5 630 451.5
			forecolor				1 1 1 1
			visible					1
			decoration
			backcolor				0.031 0.055 0.11 0.97
			bordercolor				0.11 0.18 0.29 1
			radius					9.6
			shadow					21
		}

		itemDef
		{
			name					vidwarn_title
			group					vidwarn
			style					WINDOW_STYLE_EMPTY
			text					@MENUS_UNAPPLIED_VIDEO_CHANGES
			rect					180 193.5 600 30
			font					5
			textscale				1.11
			textalign				ITEM_ALIGN_CENTER
			textalignx				300
			textaligny				-0.75
			forecolor				0.86 0.90 0.945 1
			visible					1
			decoration
			caps					1
		}

		itemDef
		{
			name					vidwarn_text1
			group					vidwarn
			text					@MENUS_YOU_HAVE_MADE_CHANGES
			rect					315 345 330 30
			textalign				ITEM_ALIGN_CENTER
			text2aligny				27
			textalignx				165
			font					5
			textscale				1.29
			forecolor				0.91 0.77 0.42 1
			visible					1
			decoration
			textaligny				2.25
		}

		itemDef
		{
			name					vidwarn_text2
			group					vidwarn
			text					@MENUS_APPLY_THESE_CHANGES_OR
			rect					315 375 330 30
			textalign				ITEM_ALIGN_CENTER
			textalignx				165
			font					5
			textscale				1.29
			forecolor				0.91 0.77 0.42 1
			visible					1
			textaligny				2.25
		}

		itemDef
		{
			name					vidwarn_no
			group					vidwarn
			text					@MENUS_DISCARD
			type					ITEM_TYPE_BUTTON
			style					WINDOW_STYLE_PANEL
			rect					277.5 582 165 30
			font					5
			textscale				0.96
			textalign				ITEM_ALIGN_CENTER
			textalignx				82.5
			textaligny				6
			descText				@MENUS_DO_NOT_APPLY_CHANGES
			forecolor				0.86 0.90 0.945 1
			visible					1
			action
			{
				play "sound/interface/button1.wav" ;
				close "videowarningMenu" ;
				setcvar "ui_r_modified" 0 ;
				rundeferred ;
			}
			mouseEnter { show vidwarn_no_button }
			mouseExit { hide vidwarn_no_button }
			caps					1
			radius					4.8
			backcolor				0 0 0 0
			bordercolor				0.153 0.251 0.373 1
		}

		itemDef
		{
			name					vidwarn_yes
			group					vidwarn
			text					@MENUS_APPLY
			type					ITEM_TYPE_BUTTON
			style					WINDOW_STYLE_PANEL
			rect					517.5 582 165 30
			font					5
			textscale				0.96
			textalign				ITEM_ALIGN_CENTER
			textalignx				82.5
			textaligny				6
			descText				@MENUS_APPLY_CHANGES_AND_THEN
			forecolor				0.016 0.071 0.122 1
			visible					1
			action
			{
				play "sound/interface/button1.wav" ;
				uiScript updatevideosetup ;
				close all
			}
			mouseEnter { show vidwarn_yes_button }
			mouseExit { hide vidwarn_yes_button }
			caps					1
			radius					4.8
			backcolor				0.36 0.78 0.96 1
			bordercolor				0.36 0.78 0.96 1
		}
		canvas					1600 900
	}
}
