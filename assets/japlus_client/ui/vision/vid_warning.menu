// vid_warning.menu in the new look. Made by tools/menus/build.py from ui/jamp/vid_warning.menu: change that script or its
// rules, not this file. See docs/japlus/ui.md.
{
	menuDef
	{
		name					"videowarningMenu"
		visible					0
		fullScreen				0
		rect					0 0 640 480
		focusColor				0.43 0.83 1 1
		outOfBoundsClick
		descX					320
		descY					434
		descScale				1
		descColor				0.60 0.69 0.78 1
		descAlignment			ITEM_ALIGN_CENTER
		popup
		onESC
		{
			play "sound/interface/button1.wav" ;
			close "videowarningMenu" ;
			setcvar "ui_r_modified" 0 ;
			rundeferred ;
		}
		onClose { play "sound/interface/button1.wav" ; }

		itemDef
		{
			name					warn_background
			group					none
			style					WINDOW_STYLE_PANEL
			rect					100 100 440 320
			forecolor				1 1 1 1
			visible					1
			decoration
			backcolor				0.035 0.07 0.12 0.55
			bordercolor				0.43 0.83 1 0.16
			radius					5
		}

		itemDef
		{
			name					vidwarn_title
			group					vidwarn
			style					WINDOW_STYLE_EMPTY
			text					@MENUS_UNAPPLIED_VIDEO_CHANGES
			rect					120 129 400 20
			font					5
			textscale				0.74
			textalign				ITEM_ALIGN_CENTER
			textalignx				200
			textaligny				-0.5
			forecolor				0.86 0.92 0.97 1
			visible					1
			decoration
			caps					1
		}

		itemDef
		{
			name					vidwarn_text1
			group					vidwarn
			text					@MENUS_YOU_HAVE_MADE_CHANGES
			rect					210 230 220 20
			textalign				ITEM_ALIGN_CENTER
			text2aligny				18
			textalignx				110
			font					5
			textscale				0.86
			forecolor				.79 .64 .22 1
			visible					1
			decoration
			textaligny				1.5
		}

		itemDef
		{
			name					vidwarn_text2
			group					vidwarn
			text					@MENUS_APPLY_THESE_CHANGES_OR
			rect					210 250 220 20
			textalign				ITEM_ALIGN_CENTER
			textalignx				110
			font					5
			textscale				0.86
			forecolor				.79 .64 .22 1
			visible					1
			textaligny				1.5
		}

		itemDef
		{
			name					vidwarn_no
			group					vidwarn
			text					@MENUS_DISCARD
			type					ITEM_TYPE_BUTTON
			style					WINDOW_STYLE_EMPTY
			rect					180 386 120 24
			font					5
			textscale				0.86
			textalign				ITEM_ALIGN_CENTER
			textalignx				60
			textaligny				-1.5
			descText				@MENUS_DO_NOT_APPLY_CHANGES
			forecolor				.79 .64 .22 1
			visible					1
			action
			{
				play "sound/interface/button1.wav" ;
				close "videowarningMenu" ;
				setcvar "ui_r_modified" 0 ;
				rundeferred ;
			}
			mouseEnter { show vidwarn_no_button }
			mouseExit { hide vidwarn_no_button }
		}

		itemDef
		{
			name					vidwarn_yes
			group					vidwarn
			text					@MENUS_APPLY
			type					ITEM_TYPE_BUTTON
			style					WINDOW_STYLE_EMPTY
			rect					340 386 120 24
			font					5
			textscale				0.86
			textalign				ITEM_ALIGN_CENTER
			textalignx				60
			textaligny				-1.5
			descText				@MENUS_APPLY_CHANGES_AND_THEN
			forecolor				.79 .64 .22 1
			visible					1
			action
			{
				play "sound/interface/button1.wav" ;
				uiScript updatevideosetup ;
				close all
			}
			mouseEnter { show vidwarn_yes_button }
			mouseExit { hide vidwarn_yes_button }
		}
		skin					1
		disableColor			0.36 0.42 0.50 1
		openSlide				8
	}
}
