{
	menuDef
	{
		name					"createserver"
		fullScreen				MENU_TRUE
		rect					0 0 640 480
		visible					1
		focusColor				0.36 0.78 0.96 1
		descX					12
		descY					428
		descScale				0.6
		descColor				0.56 0.64 0.74 1
		descAlignment			ITEM_ALIGN_LEFT
		onEsc
		{
			setcvartocvar password g_password
			close createserver
			open multiplayermenu
			uiscript checkservername
		}
		onOpen
		{
			setcvartocvar password g_password
			uiScript loadArenas
			hide accept_alt
			show accept
			hide back_alt
			show back
			hide grpmessage
			uiScript setBotButtons
			uiscript clampmaxplayers
			uiscript checkservername
		}

