// controls.menu in the new look. Made by tools/menus/build.py from ui/jamp/controls.menu: change that script or its
// rules, not this file. See docs/japlus/ui.md.
{
	menuDef
	{
		name					"controlsMenu"
		fullScreen				1
		rect					0 0 640 480
		visible					0
		focusColor				0.43 0.83 1 1
		descX					40
		descY					80
		descScale				0.8
		descColor				0.60 0.69 0.78 1
		descAlignment			ITEM_ALIGN_LEFT
		onOpen
		{
			uiScript loadControls;
			show setup_background ;
			show movecontrols ;
			hide attackcontrols ;
			hide weaponcontrols ;
			hide forcecontrols ;
			hide forcecontrols2 ;
			hide quickcontrols ;
			hide joycontrols ;
			hide othercontrols ;
			hide japluscontrols;
			setitemcolor movementcontrolbutton forecolor 0.43 0.83 1 1 ;
			setitemcolor attackcontrolbutton forecolor 0.86 0.92 0.97 1 ;
			setitemcolor weaponscontrolbutton forecolor 0.86 0.92 0.97 1 ;
			setitemcolor forcecontrolbutton forecolor 0.86 0.92 0.97 1 ;
			setitemcolor forcecontrolbutton2 forecolor 0.86 0.92 0.97 1 ;
			setitemcolor quickcontrolbutton forecolor 0.86 0.92 0.97 1 ;
			setitemcolor mousejoystickcontrolbutton forecolor 0.86 0.92 0.97 1 ;
			setitemcolor othercontrolbutton forecolor 0.86 0.92 0.97 1 ;
			setitemcolor japluscontrolbutton forecolor 0.86 0.92 0.97 1 ;
		}
		onClose { uiScript saveControls }
		onESC
		{
			play "sound/interface/menuroam.wav" ;
			hide highlights ;
			close controlsMenu ;
			open main ;
		}

