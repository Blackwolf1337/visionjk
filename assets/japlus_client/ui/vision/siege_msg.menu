{
	menuDef
	{
		name					"siege_popmenu"
		visible					0
		fullscreen				0
		rect					158 80 324 331
		focusColor				0.36 0.78 0.96 1
		style					WINDOW_STYLE_EMPTY
		popup
		onClose {  }
		onOpen {  }
		onESC
		{
			close siege_popmenu
			open main
		}

		itemDef
		{
			name					window
			rect					0 40 324 291
			style					WINDOW_STYLE_PANEL
			backcolor				0.031 0.055 0.11 0.97
			forecolor				0 0 0 1
			bordercolor				0.11 0.18 0.29 1
			visible					1
			decoration
			radius					6.4
			shadow					14
		}

		itemDef
		{
			name					siegeinfo
			rect					0 50 320 20
			text					@MENUS_DATAPAD
			textalign				1
			textstyle				0
			textscale				0.86
			textalignx				160
			forecolor				0.86 0.90 0.945 1
			visible					1
			decoration
			font					5
			textaligny				1.5
		}

		itemDef
		{
			name					siegeinfo
			rect					60 80 200 270
			type					ITEM_TYPE_TEXT
			style					WINDOW_STYLE_EMPTY
			textstyle				0
