{
	menuDef
	{
		name					"siege_popmenu"
		visible					0
		fullscreen				0
		rect					158 80 324 331
		focusColor				0.43 0.83 1 1
		style					WINDOW_STYLE_EMPTY
		popup
		onClose {  }
		onOpen {  }
		onESC
		{
			close siege_popmenu
			open main
		}

		itemDef
		{
			name					window
			rect					0 40 324 291
			style					WINDOW_STYLE_PANEL
			backcolor				0.035 0.07 0.12 0.94
			forecolor				0 0 0 1
			bordercolor				0.43 0.83 1 0.28
			visible					1
			decoration
			radius					8
			shadow					14
			sheen					0.08
		}

		itemDef
		{
			name					siegeinfo
			rect					0 50 320 20
			text					@MENUS_DATAPAD
			textalign				1
			textstyle				0
			textscale				0.86
			textalignx				160
			forecolor				0.86 0.92 0.97 1
			visible					1
			decoration
			font					5
			textaligny				1.5
		}

		itemDef
		{
			name					siegeinfo
			rect					60 80 200 270
			type					ITEM_TYPE_TEXT
			style					WINDOW_STYLE_EMPTY
			textstyle				0
			autowrapped
			cvar					"cg_siegeMessage"
