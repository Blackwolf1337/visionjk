			textscale				0.86
			forecolor				0.86 0.90 0.945 1
			visible					1
			decoration
			font					5
		}

		itemDef
		{
			name					exit
			group					grpControlbutton
			text					@MENUS_OKAY
			type					1
			textscale				0.64
			type					ITEM_TYPE_BUTTON
			style					WINDOW_STYLE_PANEL
			rect					125.5 298 70 20
			textalign				ITEM_ALIGN_CENTER
			textalignx				35
			forecolor				0.016 0.071 0.122 1
			visible					1
			action
			{
				play "sound/interface/button1.wav" ;
				close siege_popmenu
			}
			mouseEnter { show button_glow }
			mouseExit { hide button_glow }
			font					5
			textaligny				4
			caps					1
			radius					3.2
			backcolor				0.36 0.78 0.96 1
