// VisionJK: thermal/explosion of the game for rd-vulkan-vision (client/fx/FxScheduler.cpp RegisterEffect takes
// effects/vision/fb first): its parts as they were, a ball of fire from a flipbook added. Its smoke: smoke.efx beside this.

// VisionJK (rd-vulkan-vision): a ball of fire from the flipbook (tools/materials/flipbooks.py)
Particle
{
	name				Fireball
	count				3
	life				600 800
	delay				0 60
	origin				6 -12 -12 16 12 12
	rotation			0 360
	rotationDelta		-1 1
	velocity			10 -18 -18 30 18 18
	frames				8 8
	size
	{
		start			28 36
		end				62 80
		flags			linear
	}
	shaders
	[
		gfx/vision/fb/fireball
	]
}

Particle
{
	name				explosion_cloud

	count				6 8

	life				500 1000
	spawnflags			rgbComponentInterpolation

	origin			0 -10 -10 	10 10 10

	rotation			0 360

	rotationDelta		-8 8

	velocity			35 -25 -25 	70 25 25

	rgb
	{
		start	1 1 1		1 0.5 0.5
	}

	alpha
	{
		start			0.8	1.0
		end			0
		parms			50
		flags			linear nonlinear
	}

	size
	{
		start			20 25
		end			45 60
		flags			linear
	}

	shaders
	[
		gfx/misc/exp02_2
		gfx/misc/exp02_3
		effects/fire
	]
}

