textures/desert/sandfloor2b
{
	q3map_shadeangle 150
	qer_editorimage textures/desert/sandfloor2b
	q3map_material Sand
	q3map_nonplanar
	q3map_splotchfix
	{
		map $lightmap
		rgbGen identity
	}
	{
		map textures/desert/sandfloor2b
		blendFunc GL_DST_COLOR GL_ZERO
		rgbGen identity
		normalGen 0.3 2 0.3 invert
		rmoGen 0.3 0.3
		roughness 0.85
		metalness 0
		parallaxDepth 0.015
		parallaxPlane 0.5
	}
}

