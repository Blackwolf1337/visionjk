// materials of the material debug menu (v_matdebug) for zz_mat_desert.oshader, read after the shader files

textures/desert/stucco
{
	q3map_material Plaster
	{
		map $lightmap
	}
	{
		map textures/desert/stucco
		blendFunc GL_DST_COLOR GL_ZERO
		albedoGen cccccc 0 1
		normalGen 0.5 1 0.3
		roughness 0.85
		metalness 0
	}
	{
		map textures/common/detail5
		blendFunc GL_DST_COLOR GL_ONE
		rgbGen identity
		tcMod scale 3 3
	}
}

