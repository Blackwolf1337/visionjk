// materials of the material debug menu (v_matdebug) for danger.shader, read after the shader files

textures/danger/floor
{
	emissive 0
	q3map_material SolidMetal
	{
		map $lightmap
	}
	{
		map textures/danger/floor
		blendFunc GL_DST_COLOR GL_ZERO
		normalGen 0.4 2 0.3
		rmoGen 0.2 0.4
		roughness 0.8
		metalness 0.05
	}
}
