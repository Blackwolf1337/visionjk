models/map_objects/ships/academy_body
{
	emissive 0
	{
		map $lightmap
		rgbGen identity
	}
	{
		map models/map_objects/ships/academy_body
		blendFunc GL_DST_COLOR GL_ZERO
		rgbGen identity
	}
	{
