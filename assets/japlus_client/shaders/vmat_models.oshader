{
	emissive 0
	{
		map $lightmap
		rgbGen identity
	}
	{
		map models/map_objects/ships/academy_frame
		blendFunc GL_DST_COLOR GL_ZERO
		rgbGen identity
	}
	{
		map models/map_objects/ships/academy_frame_glow
		blendFunc GL_ONE GL_ONE
		glow
		rgbGen identity
