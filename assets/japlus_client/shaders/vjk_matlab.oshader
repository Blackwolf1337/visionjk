// the test map of the materials (tools/maps/matlab.py writes this file, do not edit it by hand): with the materials of rd-vulkan-vision, read after the shader files

textures/vjk_matlab/floor
{
	qer_editorimage textures/vjk_matlab/floor.png
	{
		map $lightmap
	}
	{
		map textures/vjk_matlab/floor.png
		blendFunc GL_DST_COLOR GL_ZERO
		normalGen 0.6 1 0.3
		roughness 0.85
		metalness 0
	}
}

