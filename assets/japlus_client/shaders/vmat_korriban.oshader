textures/korriban/os_basewalk
{
	q3map_material Rock
	{
		map $lightmap
	}
	{
		map textures/korriban/os_basewalk
		blendFunc GL_DST_COLOR GL_ZERO
		normalGen 0.4 2 0.3
		roughness 0.85
		metalness 0
		parallaxDepth 0.01
		parallaxPlane 0.5
	}
}

