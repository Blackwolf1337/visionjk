textures/taspir/256_128rustv
{
	qer_editorimage textures/taspir/256_128rustv
	{
		map $lightmap
	}
	{
		map textures/taspir/256_128rustv
		blendFunc GL_DST_COLOR GL_ZERO
		normalGen 0.4 2 0.3
		rmoGen 0.3 0.4
		roughness 0.7
		metalness 0.1
	}
	{
		map textures/taspir/256_128rustv_glow
		blendFunc GL_ONE GL_ONE
		glow
		rgbGen identity
	}
