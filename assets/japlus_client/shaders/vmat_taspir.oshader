// materials of the material debug menu (v_matdebug) for taspir.shader, read after the shader files

textures/taspir/t_wall5
{
	{
		map $lightmap
	}
	{
		map textures/taspir/t_wall5
		blendFunc GL_DST_COLOR GL_ZERO
		normalGen 0.4 2 0.3
		rmoGen 0.2 0.4
		roughness 0.6
		metalness 0.1
	}
	{
		map textures/taspir/t_wall5_glow
		blendFunc GL_ONE GL_ONE
		glow
		rgbGen identity
	}
}

textures/taspir/door
{
	qer_editorimage textures/taspir/door
	{
		map $lightmap
	}
	{
		map textures/taspir/door
		blendFunc GL_DST_COLOR GL_ZERO
		normalGen 0.4 2 0.3
		rmoGen 0.2 0.4
		roughness 0.6
		metalness 0.1
	}
	{
		map textures/taspir/door_glow
		blendFunc GL_ONE GL_ONE
		glow
		rgbGen identity
	}
}

textures/taspir/smalltrim
{
	qer_editorimage textures/taspir/smalltrim
	{
		map $lightmap
	}
	{
		map textures/taspir/smalltrim
		blendFunc GL_DST_COLOR GL_ZERO
		normalGen 0.4 2 0.3
		rmoGen 0.2 0.4
		roughness 0.6
		metalness 0.1
	}
	{
		map textures/taspir/smalltrim_glow
		blendFunc GL_ONE GL_ONE
