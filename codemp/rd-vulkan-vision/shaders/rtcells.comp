#version 460
#extension GL_EXT_ray_query : require
#extension GL_EXT_buffer_reference : require
#extension GL_EXT_buffer_reference_uvec2 : require

// Once per level (vk_rt.cpp, VK_RT_TraceCells): from every lit cell of the light grid towards every fixture of the
// level, whether nothing of the level (mask 1) is between them, and along the direction of its light whether that
// gets out to the sky. Ten words back for each cell: 1 when it gets out, how far it got (a float), eight words of
// bits, one for each fixture it sees.

layout( local_size_x = 64 ) in;

layout( set = 0, binding = 0 ) uniform accelerationStructureEXT u_top;

layout( buffer_reference, std430, buffer_reference_align = 16 ) readonly buffer Cells {
	vec4	rows[];			// two a cell: its middle, the direction of its light
};
layout( buffer_reference, std430, buffer_reference_align = 16 ) readonly buffer Fixtures {
	vec4	rows[];			// two a fixture: its middle and how far it goes from there, the side it lights
};
layout( buffer_reference, std430, buffer_reference_align = 4 ) writeonly buffer Hits {
	uint	words[];
};

layout( push_constant ) uniform Trace {
	uvec2	cells;
	uvec2	fixtures;
	uvec2	hits;
	uint	numCells;
	uint	numFixtures;
} u;

#define REACH	8192.0

// how far the first triangle of the level is along the ray, tMax: none
float Closest( vec3 origin, vec3 dir, float tMax ) {
	rayQueryEXT query;

	rayQueryInitializeEXT( query, u_top, gl_RayFlagsOpaqueEXT, 0x01u, origin, 0.0, dir, tMax );
	while ( rayQueryProceedEXT( query ) ) {
	}
	if ( rayQueryGetIntersectionTypeEXT( query, true ) == gl_RayQueryCommittedIntersectionNoneEXT ) {
		return tMax;
	}
	return rayQueryGetIntersectionTEXT( query, true );
}

void main() {
	uint i = gl_GlobalInvocationID.x;

	if ( i >= u.numCells ) {
		return;
	}
	Cells cells = Cells( u.cells );
	Fixtures fixtures = Fixtures( u.fixtures );
	Hits hits = Hits( u.hits );
	vec3 origin = cells.rows[i * 2u].xyz;
	float out_ = Closest( origin, normalize( cells.rows[i * 2u + 1u].xyz ), REACH );
	uint seen[8] = uint[8]( 0u, 0u, 0u, 0u, 0u, 0u, 0u, 0u );

	for ( uint f = 0u; f < u.numFixtures; f++ ) {
		vec4 fixture = fixtures.rows[f * 2u];
		vec3 to = fixture.xyz - origin;
		float d = length( to );
		// up to where the fixture begins: it may be in the level itself
		float reach = d - fixture.w - 1.0;

		if ( reach <= 1.0 || Closest( origin, to / d, reach ) >= reach ) {
			seen[f >> 5u] |= 1u << ( f & 31u );
		}
	}
	hits.words[i * 10u] = out_ >= REACH ? 1u : 0u;
	hits.words[i * 10u + 1u] = floatBitsToUint( out_ );
	for ( uint k = 0u; k < 8u; k++ ) {
		hits.words[i * 10u + 2u + k] = seen[k];
	}
}
